# Copy to .env. No keys are required.
# Identify this checkout on outbound requests. Do not put a URL in it.
BAYESRATINGS_USER_AGENT=your-name bayesratings-models

# SQLite file. Created by `bayesratings init`.
BAYESRATINGS_DB=data/bayesratings.db

# Status lines and the write-lock directory. Both default inside the checkout.
BAYESRATINGS_STATUS_DIR=data/status
BAYESRATINGS_LOCK_DIR=data

# Optional. Full path of the writer lock. Overrides BAYESRATINGS_LOCK_DIR.
# BAYESRATINGS_LOCK=data/write.lock
