{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "toto",
  "main": "dawg-bot-worker.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "BOZO_ADMIN": "Kap",
    "AGENT_FEEDBACK_ENABLED": "false",
    "AGENT_BOARD_ENABLED": "true",
    "DAWG_POUND_ENABLED": "true",
    "AGENT_SETUP_ENABLED": "true",
    "RESEARCH_LAB_ENABLED": "true",
    "RESEARCH_PROJECTS_ENABLED": "false",
    "RESEARCH_UPLOAD_ENABLED": "true",
    "RESEARCH_OWNER_UID": "u_y9Pgnfml5AlhtotzlailibDR",
    "RESEARCH_UPLOAD_TENANT": "jason-bdb",
    "ELEVEN_VOICE": "1bLhIC6iHGxxaQhUlUN7",
    "MAIL_FROM": "no-reply@mail.datadawgs216.com",
    "MODEL": "grok-4.5",
    "RESEARCH_DEVELOPMENT_DATA_ENABLED": "true",
    "RESEARCH_DEVELOPMENT_MANIFEST_SHA": "f30457a1e9dc0a6d705427fe7209473b774e0ded3f996cc92bdb4d6168462e40"
  },
  "secrets": {
    "required": [
      "BOZO_PEPPER",
      "DAWG_PASS",
      "DDCC_IMPORT_TOKEN",
      "ELEVEN_KEY",
      "FB_SECRET",
      "RESEND_KEY",
      "ODDS_API_KEY",
      "SGO_KEY",
      "XAI_KEY"
    ]
  },
  "r2_buckets": [
    {
      "binding": "RESEARCH_UPLOADS",
      "bucket_name": "datadawgs-research-private"
    }
  ],
  "d1_databases": [
    {
      "binding": "SWOLE_DB",
      "database_name": "swoledawg",
      "database_id": "6829c2dd-9e9b-4724-a086-8c7bc8f8ba4a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RL",
      "id": "ffee9157b0a04cebb796acfa6046880a"
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * *",
      "9 * * * *",
      "*/5 * * * *"
    ]
  }
}
