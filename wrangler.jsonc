{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "toto",
  "main": "dawg-bot-worker.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "BOZO_ADMIN": "Kap",
    "ELEVEN_VOICE": "1bLhIC6iHGxxaQhUlUN7",
    "MAIL_FROM": "no-reply@mail.datadawgs216.com",
    "MODEL": "grok-4.5"
  },
  "secrets": {
    "required": [
      "BOZO_PEPPER",
      "BOZO_TOKENS",
      "DAWG_PASS",
      "DDCC_IMPORT_TOKEN",
      "ELEVEN_KEY",
      "FB_SECRET",
      "RESEND_KEY",
      "SGO_KEY",
      "XAI_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "SWOLE_DB",
      "database_name": "swoledawg",
      "database_id": "PASTE_FROM_WRANGLER_D1_CREATE"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RL",
      "id": "ffee9157b0a04cebb796acfa6046880a"
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * *",
      "9 * * * *",
      "*/5 * * * *"
    ]
  }
}
