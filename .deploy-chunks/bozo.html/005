<!-- ---------- hierarchy: the machine sits ABOVE the ticket now, because it is
     the frame you read the ticket through. It is visible on an OPEN board in an
     armed/idle state — the reels only STOP when the server has actually drawn. -->
<div class="card bz-carnival" id="drawCard">
  <div class="bz-hdr"><h2 class="bz" style="margin:0">This week's hierarchy</h2><span class="tm" id="drawState"></span></div>
  <div class="machine armed" id="machine">
    <div class="marq"><b id="marqText">BOZO · BOZO · BOZO</b></div>
    <div class="reels" id="reels"></div>
    <div class="leverbay">
      <span class="boss"></span>
      <!-- Real <button>: the pull is a real control. Pointer Events only — no
           touchstart branch, so mouse / pen / touch take one code path. -->
      <!-- Not disabled, and the label matches setLever('idle'): the lever is never
           refused, so the pre-JS default must not claim otherwise. JS overwrites
           both within a frame; this is what a reader with no JS is told. -->
      <button type="button" class="lever live" id="lever"
              aria-label="Pull the lever. The hierarchy has not been drawn yet, so the reels will spin and come back — there is nothing for them to stop on.">
        <span class="arm" id="arm"><span class="rod"></span><span class="knob"></span></span>
      </button>
  