  }

  const AI_DEFAULTS={url:"https://api.x.ai/v1",key:"",model:"grok-4-1-fast"};
  const AI_MODEL_FIX={"grok-4.1-fast":"grok-4-1-fast","grok-4.1":"grok-4-1-fast"};

  window.DDBot={
    // personal-key override (operator only) — everyone else goes through the proxy
    cfg(){ const c=Object.assign({},AI_DEFAULTS,cfgAI());
           if(AI_MODEL_FIX[c.model]) c.model=AI_MODEL_FIX[c.model];
           return c; },
    saveCfg(url,key,model){ try{ localStorage.setItem(LS_AI, JSON.stringify({
        url:(url||"").trim().replace(/\/+$/,"")||AI_DEFAULTS.url,
        key:(key||"").trim(),
        model:(model||"").trim()||AI_DEFAULTS.model })); }catch(e){} },
    open(){ mount(); document.getElementById("ddbDock").style.display="";
            const i=document.getElementById("ddbIn"); if(i&&innerWidth>760) i.focus(); },
    toggle(){ mount(); const d=document.getElementById("ddbDock");
              const opening=d.style.display==="none"; d.style.display=opening?"":"none";
              if(opening){ const i=document.getElementById("ddbIn"); if(i&&innerWidth>760) i.focus(); } },
    forgetPass(){ setPass(""); }
  };

  // Auto-launcher on any page that exposes a player pool — unless the page supplies its
  // own button (#aiBtn on the operator). Deferred so page scripts can define DD_POOL first.
  addEventListener("load", ()=>{
    setTimeout(()=>{
      // ⚠️ No DD_POOL gate any more — Toto is on every page. The DDMe chip further
      // down KEEPS its gate: "which of the 14 teams are you" is a draft-only question,
      // and on Bozo identity comes from the login instead.
      style();
      if(document.getElementById("aiBtn")) return;
      if(document.getElementById("ddbLaunch")) return;
      const b=document.createElement("button");
      b.id="ddbLaunch"; b.type="button";
      b.title = (window.DD_BOTCTX && window.DD_BOTCTX.title)
        || (window.DD_POOL && window.DD_POOL.length ? "Ask Toto — he reads the live draft board" : "Ask Toto");
      b.innerHTML='<span class="dg"><img src="data:image/png;base64," alt=""></span><span class="lb">Ask Toto</span>';
      // gentle attention ring until it's been opened once on this device
      try{ if(!localStorage.getItem("dd-bot-seen")) b.classList.add("nudge"); }catch(e){}
      b.addEventListener("click",()=>{
        try{ localStorage.setItem("dd-bot-seen","1"); }catch(e){}
        b.classList.remove("nudge");
        window.DDBot.toggle();
      });
      document.body.appendChild(b);
      /* ⚠️ GUARD B. 140ms of quiet before it comes back: long enough that momentum scrolling
         does not flicker it, short enough that it is already there when a reader reaches for
         it. passive so this can never delay a scroll.
         ⚠️ capture:true IS LOAD-BEARING. Scroll events do not bubble, and the tables on
         cfb.html and the receipts sheets scroll INSIDE their own container while the document
         never grows — a window-only listener sees nothing on exactly the surfaces the
         complaint named. Capture reaches them because the capture path runs even for
         non-bubbling events. */
      let ddbIdle = 0;
      addEventListener("scroll", () => {
        b.classList.add("ddb-away");
        clearTimeout(ddbIdle);
        ddbIdle = setTimeout(() => b.classList.remove("ddb-away"), 140);
      }, { passive: true, capture: true });
    }, 300);
  });
})();

/* ---------- DDMe: who is looking at THIS device ----------
   The mirrored draft state carries the OPERATOR's `settings.myTeam`. Every other device
   needs its own answer to "which team am I", so identity lives in its own localStorage
   key that DDSync never touches. Resolve by NAME first — team order can change. */
(function(){
  const KEY=(window.DDLeague ? DDLeague.storageKey("dd-me-v1") : "dd-me-v1"), listeners=[];
  const raw=()=>{ try{ return JSON.parse(localStorage.getItem(KEY)||"null"); }catch(e){ return null; } };
  const teams=()=>{ try{ const S=JSON.parse(localStorage.getItem(window.DDLeague?DDLeague.storageKey("dd-auction-v1"):"dd-auction-v1")||"null");
      return (S&&S.settings&&S.settings.teams)||[]; }catch(e){ return []; } };
  const fire=()=>listeners.forEach(f=>{ try{ f(); }catch(e){} });

  window.DDMe={
    get isSet(){ return !!raw(); },
    get name(){ const m=raw(); return m?m.name:null; },
    teams,
    idx(list){
      const t=list||teams(), m=raw();
      if(!m || !t.length) return null;
      const byName=t.findIndex(x=>x && x.name===m.name);
      if(byName>=0) return byName;                                   // name wins
      if(typeof m.ti==="number" && m.ti>=0 && m.ti<t.length) return m.ti;
      return null;
    },
    set(ti){
      const t=teams(), nm=(t[ti]||{}).name||null;
      try{ localStorage.setItem(KEY, JSON.stringify({ti:+ti, name:nm})); }catch(e){}
      fire(); return nm;
    },
    clear(){ try{ localStorage.removeItem(KEY); }catch(e){} fire(); },
    onChange(fn){ listeners.push(fn); },
    openPicker(){ openPicker(); }
  };

  function style(){
    if(document.getElementById("ddmeCSS")) return;
    const s=document.createElement("style"); s.id="ddmeCSS";
    s.textContent=`
#ddmeChip{position:fixed;left:16px;bottom:18px;z-index:58;display:flex;align-items:center;gap:7px;
  border:1px solid var(--border);background:var(--surface-1);color:var(--ink-2);border-radius:999px;
  padding:8px 15px;font-size:13.5px;font-weight:650;cursor:pointer;font-family:inherit;
  box-shadow:0 5px 18px rgba(0,0,0,.20)}
#ddmeChip:hover{border-color:var(--accent);color:var(--accent)}
#ddmeChip .who{color:var(--ink-1);font-weight:750}
#ddmeChip.unset{background:var(--accent);color:var(--accent-ink,#fff);border-color:transparent;font-size:14.5px}
#ddmeChip.unset .who{color:inherit}
#ddmePanel{position:fixed;left:16px;bottom:64px;z-index:59;background:var(--surface-1);
  border:1px solid var(--border);border-radius:12px;box-shadow:0 12px 34px rgba(0,0,0,.28);
  padding:8px;min-width:214px;max-height:60vh;overflow-y:auto;display:none}
#ddmePanel .hd{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);
  font-weight:700;padding:5px 9px 7px}
#ddmePanel button{display:block;width:100%;text-align:left;background:none;border:0;font-family:inherit;
  padding:8px 10px;border-radius:8px;color:var(--ink-1);font-size:14px;cursor:pointer}
#ddmePanel button:hover{background:color-mix(in srgb, var(--accent) 13%, transparent);color:var(--accent)}
#ddmePanel button.on{color:var(--accent);font-weight:750}
@media(max-width:760px){#ddmeChip{left:10px;bottom:12px;font-size:12.5px;padding:7px 12px}
  #ddmePanel{left:10px;bottom:56px}}
@media print{#ddmeChip,#ddmePanel{display:none!important}}`;
    document.head.appendChild(s);
  }

  function openPicker(){
    style();
    let p=document.getElementById("ddmePanel");
    if(!p){ p=document.createElement("div"); p.id="ddmePanel"; document.body.appendChild(p);
      addEventListener("click",e=>{ if(p.style.display!=="none" &&
        !p.contains(e.target) && e.target.id!=="ddmeChip" && !e.target.closest("#ddmeChip")) p.style.display="none"; });
    }
    const t=teams(), cur=window.DDMe.idx(t);
    p.textContent="";
    const h=document.createElement("div"); h.className="hd"; h.textContent="Which team are you?"; p.appendChild(h);
    t.forEach((tm,i)=>{
      const b=document.createElement("button");
      b.textContent=tm.name + (tm.owner && tm.owner!==tm.name ? "  ·  "+tm.owner : "");
      if(i===cur) b.className="on";
      b.addEventListener("click",()=>{ window.DDMe.set(i); p.style.display="none"; render();
        if(typeof window.ddRerender==="function") window.ddRerender(); else location.reload(); });
      p.appendChild(b);
    });
    p.style.display="block";
  }

  function render(){
    const c=document.getElementById("ddmeChip"); if(!c) return;
    const nm=window.DDMe.idx()!=null ? teams()[window.DDMe.idx()].name : null;
    c.className = nm ? "" : "unset";
    c.innerHTML = nm ? `You: <span class="who">${nm.replace(/[<>&]/g,"")}</span> ▾`
                     : `👤 Who are you? ▾`;
    c.title = nm ? "Change which team you are" : "Pick your team to personalize this page";
  }

  addEventListener("load",()=>{
    setTimeout(()=>{
      if(!window.DD_POOL || !window.DD_POOL.length) return;      // draft pages only
      if(document.getElementById("ddmeChip")) return;
      style();
      const b=document.createElement("button");
      b.id="ddmeChip"; b.type="button";
      b.addEventListener("click",e=>{ e.stopPropagation(); openPicker(); });
      document.body.appendChild(b);
      render();
      window.DDMe.onChange(render);
    }, 340);
  });
})();

