/* ==================== Bozo Royale ====================
   A second ruleset over the same legs, prices, closes and chart. What changes is the
   consequence: Standard names a bozo who funds the next ticket and plays again, Royale
   ELIMINATES them. The chop itself is decided on the server — see the Worker — because
   it gates who may write a leg for the rest of the season. This is the display. */
/* ---- the one Royale fact that is NEWS ----
   ⚠️ NOT A PROMPT. There used to be a timed buy-back offer here with Take and Decline
   buttons and an expiry. The re-deploy is automatic, so there is nothing to press — this
   just tells you what already happened to you and what it costs you next time.

   This is the only piece of the Royale block that stays high on the page, because it is
   a state change the reader has not seen yet. Once the week it reports is no longer the
   most recent graded week it is history, and history is a receipt: it stops rendering
   here and the chop log at the bottom of the board carries it instead.

   ⚠️ "Most recent" is read off the chop records themselves, not stored. There is no
   seen-key and no dismissal: a localStorage flag here would be rebuilding the
   lever-reveal mechanism for something that does not need it, and it would mean a reader
   on a second device gets a different page. */
function paintRoyaleAlert(){
  const el = document.getElementById('royaleAlert');
  el.innerHTML = '';
  if(!isRoyale() || onHub() || view()!=='week' || !ME) return;

  const R = S.royale || {};
  // ⚠️ filter(c=>c && c.week) — Firebase turns an object keyed by sequential week
  // numbers into an array with a null at index 0, and an unfiltered read throws.
  const chopsList = Object.values(R.chops||{}).filter(c=>c&&c.week).sort((a,b)=>b.week-a.week);
  if(!chopsList.length) return;
  const mine = chopsList.find(c=>c.chopped===ME.name);
  // ⚠️ Both spellings — a chop written before the rename says `boughtBack`. Reading only
  // the new name silently relabels a historical re-deploy as "out for good".
  if(!(mine && (mine.redeployed ?? mine.boughtBack) && hasChute(ME.name))) return;
  if(mine.week !== Math.max(...chopsList.map(c=>c.week))) return;

  el.innerHTML = `<div class="redeploy">
      <h3>🪂 You were chopped in week ${mine.week} — and re-deployed.</h3>
      <p>You're back on the next ticket automatically${mine.cost?` for <b>$${mine.cost}</b>`:''}, and you funded
      that ticket on the way through. There was nothing to accept: waiting is the one thing a way back can't
      allow, or you'd sit out the ugly weeks and drop in at the final two.
      <b>That was your one.</b> The parachute stays next to your name now, and the next chop is the end of it.</p>
    </div>`;
}

/* ---- the receipt: the epitaph, the chop log and the rules ---- */
function paintRoyaleLog(){
  const card = document.getElementById('royaleCard');
  if(!isRoyale() || onHub() || view()!=='overview'){ card.style.display='none'; return; }
  card.style.display='';

  const R = S.royale || {};
  const alive = royaleAliveNames();
  const price = settings().buyback;
  document.getElementById('royaleState').textContent = R.survivor
    ? `${teamOf(R.survivor)} took it — league over`
    : `${alive.length} still alive · one chop a week`;

  let h = '';

  const chopsList = Object.values(R.chops||{}).filter(c=>c&&c.week).sort((a,b)=>b.week-a.week);
  const mine = ME ? chopsList.find(c=>c.chopped===ME.name) : null;
  /* Your own re-deploy, once it is no longer the most recent graded week — the banner
     under the header has already stopped carrying it by then, and it still belongs
     somewhere. ⚠️ Both spellings again. */
  if(mine && (mine.redeployed ?? mine.boughtBack) && ME && hasChute(ME.name)
     && mine.week !== Math.max(...chopsList.map(c=>c.week))){
    h += `<p class="note">You were chopped in week ${mine.week} and re-deployed onto the next ticket, which you
      funded on the way through. That was your one: the parachute next to your name says the next chop is final.</p>`;
  } else if(ME && royaleOf(ME.name)?.alive === false){
    /* A season-over epitaph, not news — which is why it is down here now rather than the
       first paragraph on the board. Your own cell in the cast strip already says
       "out · wk 14"; this is the sentence explaining what that means. */
    const out = chopsList.find(c=>c.chopped===ME.name);
    h += `<p class="note">You were chopped in week ${out?out.week:'?'} and you'd already used your re-deploy —
      that's the season. You still show on the board, the ledger and the chart; your line just stops.</p>`;
  }

  /* ⚠️ There is no roster line here any more. Who is alive, who is out and in which week
     is rendered exactly once, on the cast strip in the playbill header. Two renderings
     of one fact can disagree, and the strip is already the roster. */

  /* ---- the chop log. This is a receipt for an elimination, so it records not just who
       went but which lever decided it and which levers passed on the way — and whether
       each one passed because of a TIE or because it could not be measured at all.
       Those are different failures: a tie is bad luck, an unmeasurable lever is a hole
       in the data, and reporting them as one thing hides the second behind the first. */
  // ⚠️ filter(Boolean) is not defensive padding. Firebase turns an object keyed by
  // sequential week numbers into an array with a null at index 0, so an unfiltered
  // sort here throws on null.week and takes the whole render down with it.
  const chops = Object.values(R.chops || {}).filter(c=>c && c.week).sort((a,b)=>a.week-b.week);
  if(chops.length){
    h += `<div class="chops"><h3>Chop log</h3><ol>` + chops.map(c=>{
      if(c.ticketCashed || !c.chopped)
        return `<li>Week ${c.week} — <span class="who">ticket cashed</span>. Nobody chopped; the pot carries.</li>`;
      const passed = (c.leversPassed||[]).length
        ? ` <span class="passed">passed: ` + c.leversPassed.map(x=>
            `${esc(x.lever)} <span class="${x.why==='unmeasurable'?'unmeas':'tie'}">(${esc(x.why)})</span>`).join(', ')
          + `</span>` : '';
      return `<li>Week ${c.week} — <span class="who">${esc(teamOf(c.chopped))}</span>`
        + ` <span class="by">by ${esc(c.decidedBy||'—')}</span>${passed}`
        // ⚠️ Read both spellings. Chop records written before the rename say `boughtBack`,
        // and they are the same event — a player who came back. Reading only the new name
        // silently relabels every historical re-deploy as "out for good", which is a
        // false statement about a season that actually happened.
        + ((c.redeployed ?? c.boughtBack)
            ? ' · 🪂 re-deployed'
            : ((c.hadParachute || (c.buybackForfeited === undefined && c.chopped && royaleOf(c.chopped) && hasChute(c.chopped)))
                ? ' · out for good, chute already spent' : ' · out for good'))
        + (c.survivor ? ` · <b>${esc(teamOf(c.survivor))} takes the pot</b>` : '')
        + `</li>`;
    }).join('') + `</ol></div>`;
  }

  h += `<p class="note">One chop a week, ranked by that week's drawn lever hierarchy — the first lever that
    produces a unique worst decides it. If the ticket cashes, nobody goes and the pot carries. The chopped
    player funds the next ticket, then spectates. Last one standing takes the pot.
    Get chopped with your re-deploy still in hand and you are back on the next ticket automatically${price>0?` for $${price}`:', free'} —
    one each, no decision to make, because being able to sit out and dodge bozos would be unfair to everyone still
    playing. After that the 🪂 stays next to your name and the next chop is final.</p>`;

  document.getElementById('royaleBody').innerHTML = h;
  /* ⚠️ There are no handlers here on purpose. This card used to wire up Take and Decline
     buttons against /bozo/buyback; the re-deploy is automatic, so there is nothing to
     click and that route is retired. If you find yourself adding a button back, the
     question to answer first is what a player would be deciding — because the moment
     there is a decision, the lurk-and-re-enter-at-the-final-two hole reopens. */
}

/* ==================== CLV vs. result ====================
   Ported from the standalone prototype. The maths below is deliberately unchanged and
   every piece of it is load-bearing — see the footnote the card renders.

   ⚠️ De-vig, not raw implied. −200 raw is 66.7%; de-vigged against the +180 the other
   side was actually quoted at, it is 65.1%. Using raw implied would overstate every
   favourite by roughly the hold and push the whole league's y-axis down by ~2 points.

   ⚠️ Pushes are dropped from both axes AND from n. A push says nothing about the number.

   ⚠️ A leg with no capturable close is dropped from both axes and from n as well, and
   is NEVER back-filled from the entry price. Substituting the entry would record a
   fabricated CLV of exactly zero and drag every average toward it. The header counts
   them instead, so the gap is visible rather than silently absorbed.

   ⚠️ Dot radius encodes n. A week-1 dot is one coin flip and must not look like a
   week-18 dot. This is the honesty valve on the y-axis and is not decoration. */
const CLV = {
  data: null, lid: null, loading: false,
  series: {}, dom: {}, players: [], me: null, maxWeek: 1, sports: [],
  state: { mode:'week', display:'chart', week:1, on:new Set(), sel:null, hover:null,
           band:true, sport:'all', playing:false },
  timer: null,
};

const clvImp = o => o < 0 ? (-o)/((-o)+100) : 100/(o+100);
/** proportional de-vig against the opposite side of the same two-way market */
function clvDevig(price, opp){
  if(price == null) return null;
  const a = clvImp(price);
  // ⚠️ No opposite side means no de-vig is possible. Returning raw implied here would
  // silently mix two different quantities in one average; the leg is excluded instead
  // and counted in the header.
  if(opp == null) return null;
  const b = clvImp(opp);
  return a/(a+b);
}
const clvGraded = l => (l.result==='win' || l.result==='loss')
  && l.closePrice != null && l.entryPrice != null
  && clvDevig(l.closePrice, l.closePriceOpp) != null
  && clvDevig(l.entryPrice, l.entryPriceOpp) != null;

const CLV_SHAPES = ['circle','square','triUp','triDown','diamond','plus','ex','hex'];
const clvIdent = {};
function clvBuildIdent(){
  clvIdent.map = {};
  CLV.players.forEach((p,i)=>{ clvIdent.map[p] = { cssVar:`--s${(i%8)+1}`, shape:CLV_SHAPES[i%8] }; });
}
const clvId = p => clvIdent.map[p] || { cssVar:'--s1', shape:'circle' };

/** cumulative series per player: one point per week with >=1 chartable leg */
function clvBuildSeries(sport){
  const out = {};
  for(const p of CLV.players){
    const legs = CLV.data.legs
      .filter(l => l.player===p && clvGraded(l) && (sport==='all' || l.sport===sport))
      .sort((a,b)=>a.week-b.week);
    let n=0, wins=0, sumExp=0, sumClv=0;
    const pts=[];
    for(const l of legs){
      const pC = clvDevig(l.closePrice, l.closePriceOpp);
      const pE = clvDevig(l.entryPrice, l.entryPriceOpp);
      n++; wins += l.result==='win'?1:0; sumExp += pC; sumClv += (pC-pE);
      pts.push({ player:p, week:l.week, n, wins,
        x:(sumClv/n)*100, y:((wins/n)-(sumExp/n))*100,
        expected:(sumExp/n)*100, winPct:(wins/n)*100,
        legClv:(pC-pE)*100, leg:l });
    }
    out[p]=pts;
  }
  return out;
}
const clvSeriesFor = s => CLV.series[s] || (CLV.series[s] = clvBuildSeries(s));
const clvSER = () => clvSeriesFor(CLV.state.sport);

const CLV_W=960, CLV_H=520, CLV_M={t:26,r:30,b:58,l:74};
const CLV_PW = CLV_W-CLV_M.l-CLV_M.r, CLV_PH = CLV_H-CLV_M.t-CLV_M.b;
let CLV_D = null;
const csx = v => CLV_M.l + (v-CLV_D.x0)/(CLV_D.x1-CLV_D.x0)*CLV_PW;
const csy = v => CLV_M.t + CLV_PH - (v-CLV_D.y0)/(CLV_D.y1-CLV_D.y0)*CLV_PH;
const clvRadius = n => 2.9 + 4.1*Math.sqrt(Math.min(n, CLV.maxWeek)/CLV.maxWeek);

function clvVisiblePoints(){
  const rows=[];
  for(const p of CLV.players){
    if(!CLV.state.on.has(p)) continue;
    const pts = clvSER()[p].filter(d=>d.week<=CLV.state.week);
    if(!pts.length) continue;
    if(CLV.state.mode==='season') rows.push(pts[pts.length-1]); else rows.push(...pts);
  }
  return rows;
}
/* Domain is fixed per mode over the WHOLE season, so scrubbing and playback never
   rescale the plot under the reader. Season mode gets its own tighter frame. */
function clvDomain(mode, sport){
  const S2 = clvSeriesFor(sport), all=[];
  for(const p of CLV.players){
    const pts=S2[p]; if(!pts.length) continue;
    if(mode==='season') all.push(pts[pts.length-1]); else all.push(...pts);
  }
  if(!all.length) return {x0:-1,x1:1,y0:-1,y1:1};
  const xs=all.map(d=>d.x), ys=all.map(d=>d.y);
  const pad=(lo,hi,f)=>{ const s=(hi-lo)*f||1; return [lo-s,hi+s]; };
  const f = mode==='season' ? 0.22 : 0.08;
  const [x0,x1]=pad(Math.min(0,...xs), Math.max(0,...xs), f);
  const [y0,y1]=pad(Math.min(0,...ys), Math.max(0,...ys), f);
  return {x0,x1,y0,y1};
}
const clvDom = (m,s) => CLV.dom[m+s] || (CLV.dom[m+s] = clvDomain(m,s));

/* ---------------- the luck band ----------------
   How far from zero a perfectly-calibrated bettor lands by chance alone. Binomial
   standard error on the delta, sqrt(p̄(1−p̄)/n), in probability points. n is the MEDIAN
   legs per visible player, not the mean, because pushes and missing closes leave
   players at different counts. It shrinks as the season runs — that is the point, and
   it is what stops "I'm +17 over expected" from being read as a claim. */
function clvLuckBand(pts){
  if(!pts.length) return null;
  const byPlayer=new Map();
  for(const d of pts){ const cur=byPlayer.get(d.player); if(!cur||d.week>cur.week) byPlayer.set(d.player,d); }
  const lasts=[...byPlayer.values()];
  const ns=lasts.map(d=>d.n).sort((a,b)=>a-b);
  const n=ns[Math.floor(ns.length/2)];
  const pbar=lasts.reduce((s,d)=>s+d.expected/100,0)/lasts.length;
  if(!n||!isFinite(pbar)) return null;
  return { se: Math.sqrt(pbar*(1-pbar)/n)*100, n, pbar, lo: ns[0], hi: ns[ns.length-1] };
}

function clvShapePath(kind,r){
  const P=pts=>'M'+pts.map(p=>p.join(' ')).join('L')+'Z';
  const k=r*1.05;
  switch(kind){
    case 'square':  return P([[-k,-k],[k,-k],[k,k],[-k,k]]);
    case 'triUp':   return P([[0,-r*1.28],[r*1.18,r*0.78],[-r*1.18,r*0.78]]);
    case 'triDown': return P([[0,r*1.28],[r*1.18,-r*0.78],[-r*1.18,-r*0.78]]);
    case 'diamond': return P([[0,-r*1.36],[r*1.24,0],[0,r*1.36],[-r*1.24,0]]);
    case 'plus':{ const a=r*0.44,b=r*1.30; return P([[-a,-b],[a,-b],[a,-a],[b,-a],[b,a],[a,a],[a,b],[-a,b],[-a,a],[-b,a],[-b,-a],[-a,-a]]); }
    case 'ex':{ const a=r*0.42,b=r*1.22,m=(x,y)=>[(x-y)*0.7071,(x+y)*0.7071];
      return P([[-a,-b],[a,-b],[a,-a],[b,-a],[b,a],[a,a],[a,b],[-a,b],[-a,a],[-b,a],[-b,-a],[-a,-a]].map(([x,y])=>m(x,y))); }
    case 'hex':{ const pts=[]; for(let i=0;i<6;i++){ const t=Math.PI/6+i*Math.PI/3; pts.push([Math.cos(t)*r*1.22,Math.sin(t)*r*1.22]); } return P(pts); }
    default: return `M${-r*1.1} 0a${r*1.1} ${r*1.1} 0 1 0 ${r*2.2} 0a${r*1.1} ${r*1.1} 0 1 0 ${-r*2.2} 0Z`;
  }
}
const clvGlyph = (p,r,extra='') =>
  `<path d="${clvShapePath(clvId(p).shape,r)}" fill="var(${clvId(p).cssVar})" ${extra}/>`;

function clvTicks(lo,hi,count){
  const raw=(hi-lo)/count, mag=Math.pow(10,Math.floor(Math.log10(raw)));
  const step=[1,2,2.5,5,10].map(m=>m*mag).find(s=>s>=raw)||10*mag;
  const out=[]; for(let v=Math.ceil(lo/step)*step; v<=hi+1e-9; v+=step) out.push(+v.toFixed(6));
  return out;
}
const clvWeekLabel = w => (CLV.data.weeks.find(x=>x.week===w)||{}).label || ('Week '+w);
const clvShort = w => { const x=CLV.data.weeks.find(y=>y.week===w);
  return x ? (x.phase==='regular' ? 'Wk '+w : x.label) : 'Wk '+w; };
const csgn = (v,dp=1) => (v>0?'+':'')+v.toFixed(dp);

function clvRender(){
  if(!CLV.data) return;
  const st = CLV.state;
  document.getElementById('clvWeekNum').textContent = clvWeekLabel(st.week);
  const pts = clvVisiblePoints();
  const scope = CLV.data.legs.filter(l => l.week<=st.week && (st.sport==='all'||l.sport===st.sport));
  const charted = scope.filter(clvGraded).length;
  const noClose = scope.filter(l=>l.closePrice==null).length;
  const noOpp   = scope.filter(l=>l.closePrice!=null && (l.closePriceOpp==null||l.entryPriceOpp==null)).length;
  const pushes  = scope.filter(l=>l.result==='push').length;
  document.getElementById('clvHead').textContent = scope.length
    ? `${charted} of ${scope.length} legs charted · ${pushes} push${pushes===1?'':'es'} · ${noClose} with no capturable close`
      + (noOpp ? ` · ${noOpp} missing the other side` : '')
    : '';

  CLV_D = clvDom(st.mode, st.sport);
  clvRenderLegend();
  if(st.display==='table') return clvRenderTable();

  const svg = document.getElementById('clvSvg');
  if(!pts.length){
    svg.innerHTML = `<text x="${CLV_W/2}" y="${CLV_H/2}" text-anchor="middle" class="tick">`
      + `No graded legs yet — the chart fills in as weeks resolve.</text>`;
    return;
  }

  const xt=clvTicks(CLV_D.x0,CLV_D.x1,7), yt=clvTicks(CLV_D.y0,CLV_D.y1,6);
  let s='';
  /* quadrant wash: the two "market agreed with you" quadrants */
  s += `<rect x="${csx(0)}" y="${CLV_M.t}" width="${CLV_M.l+CLV_PW-csx(0)}" height="${csy(0)-CLV_M.t}" fill="var(--clv-quad)"/>`;
  s += `<rect x="${CLV_M.l}" y="${csy(0)}" width="${csx(0)-CLV_M.l}" height="${CLV_M.t+CLV_PH-csy(0)}" fill="var(--clv-quad)"/>`;

  const LB = st.band ? clvLuckBand(pts) : null;
  if(LB){
    const y2hi=Math.max(CLV_M.t,csy(2*LB.se)), y2lo=Math.min(CLV_M.t+CLV_PH,csy(-2*LB.se));
    const y1hi=Math.max(CLV_M.t,csy(LB.se)),   y1lo=Math.min(CLV_M.t+CLV_PH,csy(-LB.se));
    s += `<rect x="${CLV_M.l}" y="${y2hi}" width="${CLV_PW}" height="${Math.max(0,y2lo-y2hi)}" fill="var(--clv-band-2)"/>`;
    s += `<rect x="${CLV_M.l}" y="${y1hi}" width="${CLV_PW}" height="${Math.max(0,y1lo-y1hi)}" fill="var(--clv-band-1)"/>`;
    // Label an edge only when it is genuinely on screen — early in a season ±2 SE is off
    // the top, and pinning the label to the plot edge collides with the quadrant labels.
    if(y2hi > CLV_M.t+14)
      s += `<text class="bandlab" x="${CLV_M.l+CLV_PW-9}" y="${y2hi+14}" text-anchor="end">±2 SE · 95% of pure luck lands inside</text>`;
    if(y1lo < CLV_M.t+CLV_PH-8)
      s += `<text class="bandlab" x="${CLV_M.l+9}" y="${y1lo-7}">±1 SE · median ${LB.n} legs${LB.lo!==LB.hi?` (n = ${LB.lo}–${LB.hi})`:''}</text>`;
  }

  for(const t of yt) s += `<line x1="${CLV_M.l}" x2="${CLV_M.l+CLV_PW}" y1="${csy(t)}" y2="${csy(t)}" stroke="var(--grid)" stroke-width="1"/>`;
  for(const t of xt) s += `<line y1="${CLV_M.t}" y2="${CLV_M.t+CLV_PH}" x1="${csx(t)}" x2="${csx(t)}" stroke="var(--grid)" stroke-width="1"/>`;
  s += `<line x1="${CLV_M.l}" x2="${CLV_M.l+CLV_PW}" y1="${csy(0)}" y2="${csy(0)}" stroke="var(--axis)" stroke-width="1.5"/>`;
  s += `<line y1="${CLV_M.t}" y2="${CLV_M.t+CLV_PH}" x1="${csx(0)}" x2="${csx(0)}" stroke="var(--axis)" stroke-width="1.5"/>`;
  for(const t of yt) s += `<text class="tick" x="${CLV_M.l-12}" y="${csy(t)+4}" text-anchor="end">${t>0?'+':''}${t}</text>`;
  for(const t of xt) s += `<text class="tick" x="${csx(t)}" y="${CLV_M.t+CLV_PH+20}" text-anchor="middle">${t>0?'+':''}${t}</text>`;
  s += `<text class="axtitle" x="${CLV_M.l+CLV_PW/2}" y="${CLV_H-14}" text-anchor="middle">Closing line value · probability points →</text>`;
  s += `<text class="axtitle" transform="translate(19,${CLV_M.t+CLV_PH/2}) rotate(-90)" text-anchor="middle">Win rate over expected · points →</text>`;
  s += `<text class="quadlab" x="${CLV_M.l+CLV_PW-9}" y="${CLV_M.t+16}" text-anchor="end">good prices · winning more</text>`;
  s += `<text class="quadlab" x="${CLV_M.l+9}" y="${CLV_M.t+CLV_PH-9}">bad prices · losing more</text>`;

  const emph = st.sel || st.hover;
  if(emph && st.mode==='week' && st.on.has(emph)){
    const tp = clvSER()[emph].filter(d=>d.week<=st.week);
    if(tp.length>1)
      s += `<polyline points="${tp.map(d=>`${csx(d.x)},${csy(d.y)}`).join(' ')}" fill="none"`
         + ` stroke="var(${clvId(emph).cssVar})" stroke-width="2" stroke-linejoin="round"`
         + ` stroke-linecap="round" opacity="0.62"/>`;
  }

  const order = pts.slice().sort((a,b)=>(a.player===emph?1:0)-(b.player===emph?1:0));
  const seasonMode = st.mode==='season';
  for(const d of order){
    const isEmph = d.player===emph, dim = emph && !isEmph;
    const own = clvSER()[d.player].filter(q=>q.week<=st.week);
    const last = own.length && d.week===own[own.length-1].week;
    const r = seasonMode ? 9 : clvRadius(d.n);
    const op = dim ? 0.16 : (seasonMode||isEmph ? 1 : (last ? 0.95 : 0.62));
    s += `<g transform="translate(${csx(d.x)},${csy(d.y)})" opacity="${op}">`
       + clvGlyph(d.player, r, `stroke="var(--surface-1)" stroke-width="2"`) + `</g>`;
  }

  if(seasonMode){
    for(const L of clvPlaceLabels(pts.map(d=>({text:d.player, x:csx(d.x), y:csy(d.y), player:d.player})))){
      const dim = emph && L.player!==emph;
      s += `<text class="dotlabel" x="${L.lx}" y="${L.ly}" text-anchor="${L.anchor}" opacity="${dim?0.25:1}">${esc(L.text)}</text>`;
    }
  } else if(emph && st.on.has(emph)){
    const tp = clvSER()[emph].filter(d=>d.week<=st.week);
    if(tp.length){ const d=tp[tp.length-1];
      s += `<text class="dotlabel" x="${csx(d.x)+15}" y="${csy(d.y)+4}">${esc(emph)} · ${esc(clvShort(d.week))}</text>`; }
  }
  svg.innerHTML = s;
  svg.__pts = pts;
}

/* greedy label placement so season-mode names don't overlap */
function clvPlaceLabels(items){
  const placed=[], out=[];
  const cand=(x,y,w)=>[
    {lx:x+13,ly:y+4,anchor:'start',box:[x+13,y-6,x+13+w,y+8]},
    {lx:x-13,ly:y+4,anchor:'end',box:[x-13-w,y-6,x-13,y+8]},
    {lx:x,ly:y-15,anchor:'middle',box:[x-w/2,y-25,x+w/2,y-11]},
    {lx:x,ly:y+24,anchor:'middle',box:[x-w/2,y+14,x+w/2,y+28]}];
  const hits=b=>placed.some(p=>!(b[2]<p[0]||b[0]>p[2]||b[3]<p[1]||b[1]>p[3]));
  for(const it of items){
    const w=it.text.length*7.2;
    const pick=cand(it.x,it.y,w).find(c=>!hits(c.box))||cand(it.x,it.y,w)[0];
    placed.push(pick.box); out.push({...it,...pick});
  }
  return out;
}

function clvRenderLegend(){
  const el=document.getElementById('clvLegend');
  const R = CLV.data.royale;
  el.innerHTML = CLV.players.map(p=>{
    const on=CLV.state.on.has(p);
    // Chopped players stay on the chart with a DEAD badge — their line simply stops.
    const rs = R && R.status ? R.status[encodeURIComponent(p)] : null;
    const dead = rs && rs.alive === false;
    return `<button class="pchip" data-p="${esc(p)}" data-on="${on}" data-sel="${CLV.state.sel===p}"`
      + ` aria-pressed="${on}" title="Click to focus · shift-click to hide">`
      + `<svg width="15" height="15" viewBox="-8 -8 16 16">${clvGlyph(p,5.4)}</svg>`
      + `<span>${esc(teamOf(p))}</span>`
      + (hasChute(p)?'<span class="chute" title="Re-deployed. One chop from out.">🪂</span>':'')
      + (CLV.me===p?'<span class="me">YOU</span>':'')
      + (dead?`<span class="dead">OUT · WK ${rs.eliminatedWeek??'?'}</span>`:'')
      + `</button>`;
  }).join('') + `<button class="pchip" data-p="__all" data-on="true" data-sel="false" title="Show everyone">All</button>`;

  el.querySelectorAll('.pchip').forEach(c=>{
    c.onclick = e => {
      const p=c.dataset.p;
      if(p==='__all'){ CLV.state.on=new Set(CLV.players); CLV.state.sel=null; return clvRender(); }
      if(e.shiftKey){ CLV.state.on.has(p)?CLV.state.on.delete(p):CLV.state.on.add(p); if(CLV.state.sel===p) CLV.state.sel=null; }
      else { CLV.state.sel = CLV.state.sel===p ? null : p; CLV.state.on.add(p); }
      clvRender();
    };
    c.onmouseenter = ()=>{ if(c.dataset.p!=='__all' && !CLV.state.sel){ CLV.state.hover=c.dataset.p; clvRender(); } };
    c.onmouseleave = ()=>{ if(CLV.state.hover){ CLV.state.hover=null; clvRender(); } };
  });
}

/* The table twin is the WCAG counterpart AND the relief for the light-mode contrast
   warning the palette check raised. Every value in the chart is reachable here.
   ⚠️ Do not delete it to save space. */
function clvRenderTable(){
  const rows = clvVisiblePoints().sort((a,b)=>a.player.localeCompare(b.player)||a.week-b.week);
  const head = `<thead><tr><th>Player</th><th>Wk</th><th>Charted</th><th>W–L</th>`
    + `<th>Win %</th><th>Expected %</th><th>Delta (pts)</th><th>CLV (pts)</th></tr></thead>`;
  const body = rows.map(d=>`<tr>`
    + `<td>${esc(teamOf(d.player))}${d.player===CLV.me?' <span class="me">· you</span>':''}</td>`
    + `<td>${esc(clvShort(d.week))}</td><td>${d.n}</td><td>${d.wins}–${d.n-d.wins}</td>`
    + `<td>${d.winPct.toFixed(1)}</td><td>${d.expected.toFixed(1)}</td>`
    + `<td class="${d.y>=0?'pos':'neg'}">${csgn(d.y,1)}</td>`
    + `<td class="${d.x>=0?'pos':'neg'}">${csgn(d.x,2)}</td></tr>`).join('');
  document.getElementById('clvTbl').innerHTML = head + `<tbody>${body}</tbody>`;
}

/* nearest-point hover with a generous hit radius — pinpoint hit-testing on 8px dots is
   unusable on a trackpad and worse on touch */
(function clvWireHover(){
  const svg=document.getElementById('clvSvg'), tip=document.getElementById('clvTip');
  if(!svg) return;
  svg.addEventListener('mousemove', e=>{
    const pts=svg.__pts||[]; if(!CLV.data) return;
    const r=svg.getBoundingClientRect();
    const mx=(e.clientX-r.left)/r.width*CLV_W, my=(e.clientY-r.top)/r.height*CLV_H;
    let best=null, bd=34*34;
    for(const d of pts){ const dx=csx(d.x)-mx, dy=csy(d.y)-my, dd=dx*dx+dy*dy; if(dd<bd){ bd=dd; best=d; } }
    if(!best){ tip.style.opacity=0; if(CLV.state.hover&&!CLV.state.sel){ CLV.state.hover=null; clvRender(); } return; }
    if(!CLV.state.sel && CLV.state.hover!==best.player){ CLV.state.hover=best.player; clvRender(); }
    clvShowTip(best, e.clientX-r.left, e.clientY-r.top);
  });
  svg.addEventListener('mouseleave', ()=>{
    tip.style.opacity=0;
    if(CLV.state.hover&&!CLV.state.sel){ CLV.state.hover=null; clvRender(); }
  });
  svg.addEventListener('click', ()=>{
    if(CLV.state.hover){ CLV.state.sel = CLV.state.sel===CLV.state.hover ? null : CLV.state.hover; clvRender(); }
  });
})();

