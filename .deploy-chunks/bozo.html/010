`;
  }).join('');

  const gaps = live.filter(x=>{ const r=res[x.p]||{}; return r.close==null || r.closeOpp==null; }).length;
  const banner = gaps
    ? `<div class="warnbox" style="display:block;margin-bottom:10px"><b>${gaps} leg${gaps===1?'':'s'} ${gaps===1?'has':'have'} no usable closing price.</b>
        A leg needs BOTH sides to be de-vigged — with one side only it is dropped from the CLV chart and from
        <i>n</i>, exactly as if it had none. Read them off the placed ticket and fill both boxes.</div>`
    : `<div class="lil" style="margin:14px 0 6px">Closing prices — all present</div>`;

  return `<div class="lil" style="margin:16px 0 6px">Closing prices</div>` + banner + rows;
}
async function confirmGrade(payload){
  const proposal=await wPost('/bozo/grade',payload);
  if(proposal.status!=='confirm_required'||!proposal.confirm_code)
    throw new Error('The Worker did not return a grade confirmation. Nothing was written.');
  if(!window.confirm(proposal.echo+'\n\nReview the board values, then press OK to write them.'))
    return null;
  return wPost('/bozo/grade',{confirm:proposal.confirm_code});
}
async function decide(){
  const e=document.getElementById('gerr'); e.className='err'; e.textContent='';
  const results = JSON.parse(JSON.stringify(S.results||{}));
  // ⚠️ Three states. `won` alone cannot express a push, and a push coerced to false
  // is a loss — which under Bozo Royale eliminates someone. result is the truth here;
  // won is derived from it and stays null on a push.
  document.querySelectorAll('[data-w]').forEach(s=>{ if(s.value===''){return;}
    const r = results[s.dataset.w] = results[s.dataset.w]||{};
    r.result = s.value==='1' ? 'won' : s.value==='0' ? 'lost' : 'push';
    r.won    = s.value==='1' ? true  : s.value==='0' ? false  : null; });
  document.querySelectorAll('[data-a]').forEach(i=>{ if(i.value===''){return;}
    results[i.dataset.a]=results[i.dataset.a]||{}; results[i.dataset.a].actual=+i.value; });
  // ⚠️ A disabled box is a close the cron already captured. Skip it rather than sending
  // its value back — the Worker ignores edits to a captured close anyway, and reading a
  // disabled field just to have it rejected invites someone to "fix" the wrong end later.
  // ⚠️ priceNum, not +value: these boxes are text now (Android's numeric keypad has no
  // minus key) and an unparseable one has to read as "not filled in" — the same null a
  // type="number" box gave for junk — rather than sending NaN to the Worker.
  document.querySelectorAll('[data-c]').forEach(i=>{ if(i.disabled) return; const p=i.dataset.c;
    const v=priceNum(i.value); results[p]=results[p]||{}; results[p].close = Number.isFinite(v)?v:null; });
  document.querySelectorAll('[data-co]').forEach(i=>{ if(i.disabled) return; const p=i.dataset.co;
    const v=priceNum(i.value); results[p]=results[p]||{}; results[p].closeOpp = Number.isFinite(v)?v:null; });

  const picks=S.picks||{};
  let pool = Object.keys(picks).filter(p => (results[p]||{}).won === false);
  if(!pool.length){
    let written;
    try{ written=await confirmGrade({results, bozo:null, bozoWhy:'Ticket cashed. Nobody wears it.', graded:true}); }
    catch(err){ e.textContent=err.message; return; }
    if(!written){ e.textContent='Grade canceled. Nothing was written.'; return; }
    return refresh();
  }
  const M={};
  pool.forEach(p=>{
    const x=picks[p], r=results[p]||{}, sd=sdOf(x);
    let beat=0;
    if(r.actual!=null){
      // A zero on a market where zero is possible takes the floor rather than
      // pretending a Bernoulli outcome sits on the same scale as a point margin.
      if(r.actual===0 && (x.mkt==='prop'||x.mkt==='total'||x.mkt==='other') && dirOf(x)==='over') beat=999;
      else beat = beatDeficit(x.mkt, dirOf(x), x.mkt==='ml'?0:x.line,
                              x.mkt==='total'?null:r.actual, x.mkt==='total'?r.actual:null, sd) ?? 0;
    }
    /* ⚠️ CLV IS NULL WHEN THERE IS NO CLOSE, AND NULL MEANS UNMEASURABLE.
       This used to read `r.close != null ? r.close : x.price`, which quietly scored every
       leg with no captured close as EXACTLY ZERO movement — a fabricated reading, not a
       missing one, and one that beat every genuinely-negative CLV in the pool. The leg
       is dropped from this lever instead, and if no leg in the pool can be scored the
       lever passes to the next one. Both sides are required at both ends: without the
       opposite price there is no de-vig, and ranking a de-vigged number against a raw
       implied one is wrong by roughly the whole hold. */
    const pC = devigP(r.close, r.closeOpp), pE = devigP(x.price, x.entryPriceOpp);
    const clv = (pC==null || pE==null) ? null : (pC - pE);
    M[p]={odds:imp(x.price), beat, last:x.ts, clv};
  });
  const R={odds:p=>M[p].odds, beat:p=>M[p].beat, last:p=>M[p].last,
           clv:p=>M[p].clv==null ? null : -M[p].clv};
  let why='';
  for(const li of (S.order||[0,1,2,3])){
    const k=LEVERS[li].k;
    // Drop what this lever cannot score, then rank what is left. An empty set means the
    // lever is unmeasurable for this pool and the hierarchy moves on — which is a
    // different failure from a tie, and the verdict says which.
    const scored = pool.filter(p=>R[k](p)!=null);
    if(!scored.length) continue;
    const mx=Math.max(...scored.map(R[k]));
    const surv=scored.filter(p=>R[k](p)===mx);
    if(surv.length<pool.length || surv.length===1){ pool=surv; why=LEVERS[li].name; }
    if(pool.length===1) break;
  }
  const bozo=pool[0], b=picks[bozo];
  const bozoWhy=`${why||'Coin flip'} · lost ${b.label} at ${b.price} · funds next week`;
  let written;
  try{ written=await confirmGrade({results, bozo, bozoWhy, graded:true}); }
  catch(err){ e.textContent=err.message; return; }
  if(!written){ e.textContent='Grade canceled. Nothing was written.'; return; }
  refresh();
}

