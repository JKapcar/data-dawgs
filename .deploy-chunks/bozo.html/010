/* ==================== Bozo Royale — survival odds ====================
   How the season is likely to end, given how each player has actually been betting.

   ⚠️ IT BOOTSTRAPS FROM REAL LEGS. Every simulated week hands each surviving player one
   of THEIR OWN past legs, drawn at random, and redraws only the win/loss from that leg's
   own de-vigged closing probability. Nothing about a player's future betting is invented.
   That matters more than it sounds: resampling a whole real leg keeps the correlation
   between the price someone takes and how badly they tend to miss, which a fitted
   distribution would throw away — and throwing it away would systematically flatter
   whoever bets the most chalk, since chalk both wins more AND loses by less.

   ⚠️ IT IS SIMULATION, NOT A FORECAST, and it inherits every soft spot the weekly sim
   has. Legs are drawn independently; in Bozo they are not, because several players land
   on the same game most weeks. Positive correlation makes clean weeks and bloodbath
   weeks both more common than this shows. The prop SD is the weakest number in the
   build. Say so whenever these numbers are quoted.

   ⚠️ RE-DEPLOYS NEED NO ASSUMPTION. They used to: a buy-back was a choice, so the model
   had to guess how often it was taken. It is automatic now, so the simulation does
   exactly what the league does — one each, spent on the chop, never at the final two.
   One fewer invented number. */
const ROY_SIMS = 4000;

/* One player's history, as a pool to resample from. */
function royalePool(player){
  const legs = (CLV.data ? CLV.data.legs : []).filter(l =>
    l.player === player && (l.result === 'win' || l.result === 'loss'));
  const out = [];
  for(const l of legs){
    const pC = clvDevig(l.closePrice, l.closePriceOpp);
    const pE = clvDevig(l.entryPrice, l.entryPriceOpp);
    // The closing price is the bar, so it is the win probability. Where no close was
    // captured the entry stands in, flagged by `soft` so the footnote can count them.
    const p = pC != null ? pC : (pE != null ? pE : imp(l.entryPrice));
    if(!(p > 0.02 && p < 0.98)) continue;
    /* Worst Beat wants how far under its number the leg finished, in SDs. A binary leg
       has no margin at all, so it takes one from its own de-vigged price — Kap's §8.3
       call, and the same rule the server applies when it decides a real chop, so the
       simulation and the live chop agree about what "worst" means. */
    const shape = { mkt: l.mkt, line: l.line ?? 0, price: l.entryPrice, sport: l.sport, side: l.side };
    const binary = l.mkt === 'prop' || l.mkt === 'other' || l.actual == null;
    let beat;
    if(binary) beat = invNorm(p);
    else {
      const sd = sdOf(shape), exp = expected(shape);
      beat = sd > 0 ? (dirOf(shape)==='under' ? (l.actual - exp) : (exp - l.actual)) / sd : 0;
    }
    out.push({
      p, price: l.entryPrice,
      clv: (pC != null && pE != null) ? (pC - pE) : null,
      beat,
      rank: l.rank || null,
      soft: pC == null,
      raw: l,
    });
  }
  return out;
}

function simulateRoyale(){
  if(!CLV.data || CLV.data.format !== 'royale') return null;
  const alive = royaleAliveNames();
  if(alive.length < 2) return null;
  const pools = {};
  for(const p of alive){ const q = royalePool(p); if(q.length) pools[p] = q; }
  const players = alive.filter(p => pools[p]);
  // ⚠️ Two completed weeks is the floor the handoff sets, and it is generous. With one
  // leg each the resample has nothing to resample.
  const thin = players.filter(p => pools[p].length < 2);
  if(players.length < 2) return { tooEarly: true, need: 'two players with graded legs' };

  const levers = (settings().levers || [0,1,2,3]).slice();
  // ⚠️ Always, in Royale. The cost is a price, not a switch — see royaleStatus.
  const redeploys = true;
  const status = royaleStatus_page();

  const wins = {}, nextChop = {}, aliveAt = {};
  const HORIZON = 26;
  for(const p of players){ wins[p]=0; nextChop[p]=0; aliveAt[p]=new Array(HORIZON).fill(0); }

  for(let s=0; s<ROY_SIMS; s++){
    let roster = players.slice();
    const bb = {}; for(const p of players)
      bb[p] = redeploys && ((status[p]?.redeploysLeft ?? status[p]?.buybacksLeft ?? 0) > 0);
    for(let w=0; w<HORIZON && roster.length>1; w++){
      for(const p of roster) aliveAt[p][w]++;
      // draw one real past leg for each survivor, and redraw only its outcome
      const drawn = {}, losers = [];
      for(const p of roster){
        const pool = pools[p], leg = pool[(Math.random()*pool.length)|0];
        drawn[p] = leg;
        if(Math.random() >= leg.p) losers.push(p);
      }
      if(!losers.length) continue;                       // ticket cashed, pot carries
      let victim;
      if(losers.length === 1) victim = losers[0];
      else {
        let pool = losers.slice();
        for(const li of shuffled(levers)){
          const k = LEVERS[li].k;
          const f = k==='odds' ? (p=>imp(drawn[p].price))
                  : k==='beat' ? (p=>drawn[p].beat)
                  : k==='clv'  ? (p=>drawn[p].clv==null?null:-drawn[p].clv)
                  : (p=>drawn[p].rank==null?null:drawn[p].rank);
          const scored = pool.filter(p=>f(p)!=null);
          if(!scored.length) continue;                   // unmeasurable — next lever
          let mx=-Infinity; for(const p of scored){ const v=f(p); if(v>mx) mx=v; }
          const surv = scored.filter(p=>f(p)===mx);
          if(surv.length < pool.length || surv.length===1) pool = surv;
          if(pool.length===1) break;
        }
        victim = pool[(Math.random()*pool.length)|0];    // every lever tied: coin flip
      }
      if(w===0) nextChop[victim]++;
      // ⚠️ Automatic and unconditional, matching the real rule — no probability here.
      if(bb[victim] && roster.length > 2){ bb[victim] = false; continue; }  // re-deployed
      roster = roster.filter(p=>p!==victim);
    }
    if(roster.length===1) wins[roster[0]]++;
  }

  return {
    sims: ROY_SIMS, players,
    win: Object.fromEntries(players.map(p=>[p, wins[p]/ROY_SIMS])),
    nextChop: Object.fromEntries(players.map(p=>[p, nextChop[p]/ROY_SIMS])),
    curve: Object.fromEntries(players.map(p=>[p, aliveAt[p].map(c=>c/ROY_SIMS)])),
    horizon: HORIZON,
    softLegs: players.reduce((a,p)=>a + pools[p].filter(l=>l.soft).length, 0),
    totalLegs: players.reduce((a,p)=>a + pools[p].length, 0),
    thin: thin,
    buyback: redeploys,
  };
}
