  async function ask(q){
    if(busy) return;
    const ai=cfgAI(), pass=getPass();
    const direct = !!ai.key;                        // operator override: own key, straight to xAI
    if(!direct && !BOT_URL){ say("sys","Toto isn't wired up yet — no proxy configured."); return; }
    if(!direct && !pass && !sess()){ askPass(); return; }
    if(window.DDMe && !window.DDMe.isSet && window.DD_POOL){
      say("sys","First — which team are you? Tap the “Who are you?” chip at the bottom-left, then ask again. Otherwise I'd be advising the operator's team, not yours.");
      return;
    }
    say("you",q); HIST.push({role:"user",content:q});
    busy=true; const th=say("bot","…thinking");
    try{
      const SF = surface();
      /* ⚠️ The Worker rejects any body over 24,000 bytes with a 413, which surfaces to
         the user as a bare error with no hint about what went wrong. Every surface's
         state block competes for that budget with the core prompt, the manual and the
         history — and a page like the EPA explorer can generate a lot of text. So
         budget it explicitly rather than hoping, and TELL the model it was cut, so it
         says "I can't see that part" instead of answering from a half-table. */
      const BODY_CAP = 20000;
      let stateTxt = SF.ctx();
      const frame = () => JSON.stringify({max_tokens:700, messages:[
        {role:"system",content:SYS+"\n\n"+SF.sys},
        {role:"system",content:HELP},
        {role:"system",content:MAP},
        {role:"system",content:SF.label},
        ...HIST.slice(-8)]}).length;
      const room = BODY_CAP - frame();
      if(stateTxt.length > room)
        stateTxt = stateTxt.slice(0, Math.max(400, room))
          + "\n[TRUNCATED to fit the request size limit. If a question needs the part that was cut, say so plainly rather than guessing.]";
      const url = direct ? (ai.url||"https://api.x.ai/v1")+"/chat/completions" : BOT_URL;
      const headers = direct
        ? {"Content-Type":"application/json","Authorization":"Bearer "+ai.key}
        : Object.assign({"Content-Type":"application/json"},
            sess() ? {"X-Bozo-Session":sess()} : {"X-Dawg-Pass":pass});
      const payload = {max_tokens:700,
        messages:[{role:"system",content:SYS+"\n\n"+SF.sys},
                  {role:"system",content:"SITE MANUAL (how the site works — use for how-to questions):\n"+HELP},
                  {role:"system",content:"SITE MAP (what lives on which page — use it to route):\n"+MAP},
                  {role:"system",content:SF.label+" (regenerated for every question):\n"+stateTxt},
                  ...HIST.slice(-8)]};
      if(direct) payload.model = window.DDBot.cfg().model;
      const r=await fetch(url,{method:"POST",headers,body:JSON.stringify(payload)});
      const t=await r.text();
      if(!r.ok){
        let msg=t.slice(0,200);
        try{ const j=JSON.parse(t); msg=j.error||msg; }catch(e){}
        if(r.status===401 && !direct){ setPass(""); throw new Error(msg+" Tap 🤖 again to re-enter it."); }
        throw new Error(msg);
      }
      const data=JSON.parse(t);
      const out=(((data.choices||[])[0]||{}).message||{}).content||"(empty reply)";
      HIST.push({role:"assistant",content:out});
      if(th){ th.textContent=out; th.classList.remove("dim"); }
    }catch(e){
      if(th){ th.classList.add("err"); th.classList.remove("dim");
        th.textContent = (e instanceof TypeError)
          ? "Couldn't reach Toto. Check this device is online. ("+e.message+")"
          : String(e.message||e); }
      HIST.pop();
    }finally{ busy=false; }
  }

