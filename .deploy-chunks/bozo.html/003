when the stream is open OR we heard from it in the last 30s
    get connected(){
      const es = this._es;
      if(es && es.readyState === 1) return true;
      return (Date.now() - (this._lastHeard||0)) < 30000;
    },
    // readers ← cloud. cb(state) whenever the operator publishes something newer
    subscribe(cb){
      const ep = this.endpoint(); if(!ep) return null;
      const self = this;
      let es, lastTs = 0, retry = 0;
      const open = ()=>{
        try{ es = new EventSource(ep); self._es = es; }catch(e){ return; }
        es.addEventListener("open", ()=>{ retry = 0; self._lastHeard = Date.now();
          window.dispatchEvent(new CustomEvent("ddsync",{detail:{ok:true,dir:"down"}})); });
        const handle = ev=>{
          self._lastHeard = Date.now();
          let msg; try{ msg = JSON.parse(ev.data); }catch(e){ return; }
          const d = msg && msg.data;
          const payload = d && (d.state || (d.ts ? null : d));
          const ts = d && d.ts;
          if(!payload) return;
          if(ts && ts <= lastTs) return;
          lastTs = ts || Date.now();
          window.dispatchEvent(new CustomEvent("ddsync",{detail:{ok:true,dir:"down"}}));
          try{ cb(payload); }catch(e){}
        };
        es.addEventListener("put", handle);
        es.addEventListener("patch", handle);
        es.addEventListener("error", ()=>{
          try{ es.close(); }catch(e){}
          retry = Math.min(retry + 1, 6);
          setTimeout(()=>{
            open();
            // only call it down once a reconnect has actually failed to land
            setTimeout(()=>window.dispatchEvent(new CustomEvent("ddsync",
              {detail:{ok:self.connected,dir:"down"}})), 1200);
          }, 1000 * retry);
        });
      };
      open();
      return ()=>{ try{ es.close(); }catch(e){} };
    }
  };
})();

