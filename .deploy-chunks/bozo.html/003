      "":"/llms.txt", "index":"/llms.txt",
      "board":"/data/pool.json", "master":"/data/pool.json",
      "bigboard":"/data/pool.json", "auction":"/data/pool.json",
      "report":"/data/pool.json",
      "dashboard":"/data/league.json",
      "fantasy-warroom":"/data/datadawg-dollars-method.json",
      "receipts":"/data/receipts.json",
      "stats":"/data/epa-teams.json",
      "nfelo":"/data/nfelo.json",
      "survivor":"/data/survivor.json",
      "bozo":"/data/bozo-rules.json",
      "cfb":"/data/cfb-teams.json",
      "strategy":"/data/strategy.md"
    },
    /* secondary live mirrors — linked, not rendered, so the primary view stays one file */
    also:{
      "receipts":["/data/receipts-method.md","/data/tier-audit.json"],
      "cfb":["/data/cfb-elo.json","/data/cfb-record-divergence.json","/data/cfb-model-cards.json"],
      "nfelo":["/data/models.json"],
      "bozo":["/data/bozo-rules.md"],
      "survivor":["/data/models.json"],
      "index":["/data/index.json","/data/method.md","/data/surfaces.json"],
      "":["/data/index.json","/data/method.md","/data/surfaces.json"]
    },
    stem(){
      const f = (location.pathname.split("/").pop()||"").replace(/\.html?$/,"");
      return f;
    },
    url(){ const s=this.stem(); return this.map[s] || "/llms.txt"; },
    ov:null, cv:null, raf:0, loaded:"",

    build(){
      if(this.ov) return this.ov;
      const ov = document.createElement("div");
      ov.className = "ud-ov"; ov.id = "udOverlay";
      ov.setAttribute("role","dialog");
      ov.setAttribute("aria-label","The Upside Down — machine-readable mirror of this page");
      const cv = document.createElement("canvas"); cv.className = "ud-cv"; cv.setAttribute("aria-hidden","true");
      const inr = document.createElement("div"); inr.className = "ud-in";
      inr.innerHTML =
        '<div class="ud-hd">'+
          '<span class="ud-ttl">🙃 THE <b>UPSIDE DOWN</b></span>'+
          '<span class="ud-path" id="udPath"></span>'+
          /* ⚠️ The close control carries 🙃 on purpose. The overlay is fixed inset:0,
             so the nav button underneath it is unreachable while it is open — "tap 🙃
             again" has to land on something that is actually on top. This is it, and
             it sits in the same top-right corner the nav button does. */
          '<button class="ud-x" id="udX" type="button">🙃 close · esc</button>'+
        '</div>'+
        '<div class="ud-chips" id="udChips"></div>'+
        '<div id="udNote"></div>'+
        '<div class="ud-also" id="udAlso"></div>'+
        '<pre class="ud-body" id="udBody">loading the served file…</pre>'+
        '<p class="ud-foot">This is the actual file your AI reads, fetched live from this site — '+
        'not a copy pasted into the page. Same data, dated and sourced. '+
        'Start at <a href="/data/index.json" style="color:#ff6a02">/data/index.json</a>.</p>';
      ov.append(cv, inr);
      document.body.appendChild(ov);
      inr.querySelector("#udX").addEventListener("click", ()=>this.close());
      this.ov = ov; this.cv = cv;
      return ov;
    },

    esc(s){ return String(s).replace(/[&<>]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c])); },

    /* ⚠️ ONE regex with alternation, not three chained replaces. Chaining them nests
       spans — the number pass finds the digits inside a string span it just wrote
       ("captured 2026-07-29") and repaints them green mid-sentence. One sweep, one
       decision per token.
       Only JSON gets coloured: llms.txt and strategy.md are prose, where quoted words
       would light up at random. Capped at 300KB — pool.json (82KB) and epa-teams
       (85KB) are fine; past that, plain text beats spending a phone's frame budget
       building a hundred thousand spans. */
    hilite(t, json){
      const e = this.esc(t);
      if(!json || t.length > 300000) return e;
      return e.replace(
        /("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false|null)\b|(-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)/g,
        (m, str, colon, lit, num)=>{
          if(str) return colon
            ? '<span class="ud-k">'+str+'</span>'+colon
            : '<span class="ud-s">'+str+'</span>';
          if(lit) return '<span class="ud-n">'+lit+'</span>';
          return '<span class="ud-n">'+num+'</span>';
        });
    },

    chip(label, value, cls){
      return '<span class="ud-chip'+(cls?" "+cls:"")+'"><b>'+this.esc(label)+'</b>'+this.esc(value)+'</span>';
    },

    render(url, text, manifest){
      const path = this.ov.querySelector("#udPath");
      const chips = this.ov.querySelector("#udChips");
      const note  = this.ov.querySelector("#udNote");
      const also  = this.ov.querySelector("#udAlso");
      const body  = this.ov.querySelector("#udBody");
      path.innerHTML = '<a href="'+this.esc(url)+'" target="_blank" rel="noopener">'+this.esc(url)+'</a> · '+
                       (text.length>1024 ? Math.round(text.length/1024)+" KB" : text.length+" B");

      let d = null;
      if(/\.json$/.test(url)){ try{ d = JSON.parse(text); }catch(e){ d = null; } }

      const c = [];
      if(d && typeof d === "object"){
        if(d.as_of) c.push(this.chip("as_of", d.as_of));
        if(d.tier)  c.push(this.chip("tier", d.tier==="dawg" ? "Working Dawg" : d.tier, d.tier==="dawg"?"dawg":""));
        if(d.graded === false) c.push(this.chip("graded","not yet"));
        if(d.built) c.push(this.chip("built", d.built));
        if(d.count != null) c.push(this.chip("rows", d.count));
        if(d.source) c.push(this.chip("source", d.source));
        /* receipts is the one file whose whole point is that you can check it without
           trusting us, so the hash and the canonical-string spec come to the top. */
        if(d.integrity && d.integrity.sha256){
          c.push(this.chip("sha256", d.integrity.sha256));
        }
      } else {
        /* markdown mirrors carry the same envelope in YAML front matter */
        const fm = text.match(/^(?:<!--[^]*?-->\s*)?---\r?\n([^]*?)\r?\n---/);
        if(fm){
          fm[1].split(/\r?\n/).forEach(line=>{
            const m = line.match(/^(as_of|source|title|tier|staleness):\s*(.+)$/);
            if(m) c.push(this.chip(m[1], m[2]));
          });
        }
      }
      /* llms.txt is prose — it is the one live surface with no envelope of its own, so
         its dates come from the manifest and are LABELLED as the manifest's, not as
         llms.txt's. Borrowing a date without saying where it came from is the exact
         failure mode this whole layer exists to argue against. */
      if(!c.length && manifest){
        if(manifest.as_of) c.push(this.chip("manifest as_of", manifest.as_of));
        if(manifest.data && manifest.data.files) c.push(this.chip("files", manifest.data.files.length));
        if(manifest.site) c.push(this.chip("site", manifest.site));
      }
      if(!c.length) c.push(this.chip("file", url));
      chips.innerHTML = c.join("");

      let n = "";
      if(d && d.note) n += '<div class="ud-note"><b>note:</b> '+this.esc(d.note)+'</div>';
      if(!d && manifest){
        n += '<div class="ud-note"><b>'+this.esc(url)+'</b> is prose and carries no <code>as_of</code> of its own. '+
             'The dates above are the manifest’s, from <code>/data/index.json</code> — every file listed there '+
             'carries its own <code>as_of</code>, and those are the ones to quote.</div>';
      }
      if(d && d.integrity && d.integrity.canonical_string_spec){
        n += '<div class="ud-note"><b>canonical string:</b> '+this.esc(d.integrity.canonical_string_spec)+
             (d.integrity.canonical_example_first_row
               ? ' <br><b>first row:</b> <code>'+this.esc(d.integrity.canonical_example_first_row)+'</code>' : '')+
             '</div>';
      }
      note.innerHTML = n;

      const extra = this.also[this.stem()] || [];
      also.innerHTML = extra.length
        ? "also mirrored: " + extra.map(u=>'<a href="'+this.esc(u)+'" target="_blank" rel="noopener">'+this.esc(u)+'</a>').join("")
        : "";

      body.innerHTML = this.hilite(text, !!d);
    },

    async load(){
      const url = this.url();
      if(this.loaded === url) return;
      const body = this.ov.querySelector("#udBody");
      try{
        const r = await fetch(url, {cache:"no-cache"});
        if(!r.ok) throw new Error(r.status+" "+r.statusText);
        const t = await r.text();
        let man = null;
        if(!/\.json$/.test(url) && !/^---/m.test(t.slice(0,400))){
          /* no envelope in the file itself — go get the manifest so the view still
             opens on a date. Failure here is not fatal: the body is the point. */
          try{ man = await (await fetch("/data/index.json", {cache:"no-cache"})).json(); }catch(e){}
        }
        this.render(url, t, man);
        this.loaded = url;
      }catch(e){
        /* llms.txt is the documented fallback; /data/index.json is the fallback's
           fallback, because the manifest is the one file that is always worth having. */
        if(url !== "/data/index.json"){
          try{
            const r2 = await fetch("/data/index.json", {cache:"no-cache"});
            const t2 = await r2.text();
            this.render("/data/index.json", t2);
            this.loaded = "/data/index.json";
            return;
          }catch(e2){}
        }
        body.innerHTML = '<span class="ud-w">Could not fetch '+this.esc(url)+' — '+this.esc(e.message)+
          '</span>\n\nThe file is still there: try it directly.';
      }
    },

    /* Faint drift, for the Stranger Things read. Cheap by construction: ~40 motes,
       stopped dead on close so nothing burns battery behind a closed overlay, and
       skipped entirely under prefers-reduced-motion. First thing to cut if it ever
       fights performance on the 2MB stats page. */
    motes(){
      const cv = this.cv, ctx = cv.getContext && cv.getContext("2d");
      if(!ctx) return;
      if(window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const dpr = Math.min(window.devicePixelRatio||1, 2);
      const fit = ()=>{ cv.width = innerWidth*dpr; cv.height = innerHeight*dpr; };
      fit();
      const N = innerWidth < 700 ? 22 : 44;
      const p = Array.from({length:N}, (_,i)=>({
        x: (i*97 % 100)/100, y:(i*61 % 100)/100,
        r: 0.6 + (i%5)*0.35, v: 0.06 + (i%7)*0.02, d:(i%2?1:-1)*0.03
      }));
      let t0 = 0;
      const step = (ts)=>{
        if(!this.ov.classList.contains("on")){ this.raf = 0; return; }
        const dt = t0 ? Math.min((ts-t0)/1000, 0.05) : 0; t0 = ts;
        ctx.clearRect(0,0,cv.width,cv.height);
        for(const m of p){
          m.y -= m.v*dt*0.12; m.x += m.d*dt*0.05;
          if(m.y < -0.05){ m.y = 1.05; }
          if(m.x < -0.05) m.x = 1.05; if(m.x > 1.05) m.x = -0.05;
          ctx.beginPath();
          ctx.fillStyle = "rgba(255,106,2,0.28)";
          ctx.arc(m.x*cv.width, m.y*cv.height, m.r*dpr, 0, 6.284);
          ctx.fill();
        }
        this.raf = requestAnimationFrame(step);
      };
      addEventListener("resize", fit);
      this.raf = requestAnimationFrame(step);
    },

    open(){
      this.build();
      this.ov.classList.add("on");
      this.prevY = window.scrollY;
      document.documentElement.style.overflow = "hidden";
      this.ov.scrollTop = 0;
      this.load();
      if(!this.raf) this.motes();
      const x = this.ov.querySelector("#udX"); if(x) x.focus();
    },
    close(){
      if(!this.ov) return;
      this.ov.classList.remove("on");
      document.documentElement.style.overflow = "";
      if(this.raf){ cancelAnimationFrame(this.raf); this.raf = 0; }
      const b = document.getElementById("udBtn"); if(b) b.focus();
    },
    toggle(){
      this.build();
      this.ov.classList.contains("on") ? this.close() : this.open();
    }
  };
  window.DDUpsideDown = UD;

  const udb = document.createElement("button");
  udb.className = "udbtn"; udb.id = "udBtn"; udb.type = "button";
  udb.textContent = "🙃";
  udb.title = "The Upside Down — the machine-readable version of this page";
  udb.setAttribute("aria-label","Open the Upside Down: the machine-readable version of this page");
  udb.addEventListener("click", ()=>UD.toggle());
  /* ⚠️ 🙃 goes at the FOOT of the page, not in the nav (moved 2026-08-08). It is placed
     immediately AFTER <footer> where one exists, so it inherits the page column, and at
     the end of <body> on the six pages that ship no footer (auction, bigboard, bozo,
     dashboard, dataviz, dawgs). Do not switch this to position:fixed bottom-right —
     Ask Toto's launcher already owns that corner and 🙃 would land underneath it. */
  const udrow = document.createElement("div");
  udrow.className = "udfoot";
  /* ⚠️ CEP-5A Stage 7: THE DAWGHOUSE LIVES HERE NOW, not in the menu. A shelf of blocked
     work is not somewhere to route people; it is somewhere to be able to look. This row is
     injected on every page, so one edit here reaches all 28 — the <footer> elements are not
     identical and could not carry it. */
  const udh = document.createElement("a");
  udh.className = "udhouse"; udh.href = "dawghouse.html";
  udh.textContent = "The DawgHouse";
  udh.title = "The shelf: work that is blocked, with the reason and the way back attached";
  udrow.appendChild(udh);
  udrow.appendChild(udb);
  const udft = document.querySelector("footer");
  if(udft && udft.parentNode) udft.parentNode.insertBefore(udrow, udft.nextSibling);
  else document.body.appendChild(udrow);
  document.addEventListener("keydown", e=>{
    if(e.key === "Escape" && UD.ov && UD.ov.classList.contains("on")) UD.close();
  });

  window.DDTheme.apply();

  // offline insurance: cache the draft pages so a dead venue wifi can't kill the room
  if("serviceWorker" in navigator &&
     (location.protocol === "https:" || location.hostname === "localhost")){
    navigator.serviceWorker.register("/sw.js").catch(()=>{});
  }
})();

