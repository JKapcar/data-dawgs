  document.getElementById('jlSignedIn').style.display=ME?'':'none';
  document.getElementById('jlIntro').textContent=ME
    ? 'Choose a league, then enter its shared password. Your account—not a premade roster name—gets the seat.'
    : 'Sign in or create your own account first. Then return here to choose the league and enter its shared password.';
  if(ME && !joinDirectoryLoaded && !joinDirectoryLoading) loadJoinDirectory();
}

