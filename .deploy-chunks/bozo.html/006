   draws the tiebreaker permutation. Nothing here is load-bearing for fairness —
   if you forged this whole file you still could not write a pick.
   ============================================================ */
const WORKER = 'https://toto.jkapcar4.workers.dev';
const DB     = 'https://data-dawgs-draft-default-rtdb.firebaseio.com';
const SESS_K = 'dd-bozo-sess';
/* Legacy account-recovery links may still land here as bozo.html?join=<tok>.
