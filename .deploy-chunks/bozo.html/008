  document.getElementById('dFloor').value = bd.floor;
  document.getElementById('sEdit').value  = st.allowEdit ? 'yes' : 'no';
  document.getElementById('sLockRule').value = st.lockRule;
  const lc = document.getElementById('sLockCount');
  lc.style.display = st.lockRule==='count' ? '' : 'none';
  lc.value = st.lockCount || Math.max(2, names().length);

  /* ⚠️ Format is a dropdown ONLY until the first ticket locks. After that it is a
     statement of what this season has been played under. A locked format shown as a
     disabled <select> would read as "broken"; it isn't broken, it is decided. */
  const locked = st.formatLocked;
  document.getElementById('fmtCtl').innerHTML = locked
    ? `<span class="fixedrule">${st.format==='royale'?'Bozo Royale':'Standard'} · locked</span>`
    : `<select id="sFormat">
         <option value="standard"${st.format!=='royale'?' selected':''}>Standard</option>
         <option value="royale"${st.format==='royale'?' selected':''}>Bozo Royale</option>
       </select>`;
  document.getElementById('fmtDesc').textContent = locked
    ? 'Fixed for the season — this league has already locked a ticket, and changing the ruleset now would retroactively change who should have been eliminated.'
    : 'Standard: everyone plays every week and the worst loser funds the next ticket. Bozo Royale: one player is chopped a week and the last one standing takes the pot. Locks permanently when this league places its first ticket.';
  document.getElementById('bbRow').style.display = st.format==='royale' ? '' : 'none';
  document.getElementById('sBuyback').value = st.buyback ?? 0;
  const fs = document.getElementById('sFormat');
  if(fs) fs.onchange = e => {
    document.getElementById('bbRow').style.display = e.target.value==='royale' ? '' : 'none';
    lgDirty = true;
  };

  paintLevers(st.levers);
}
