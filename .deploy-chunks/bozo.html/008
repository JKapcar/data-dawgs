const leverPick = () => [...document.querySelectorAll('[data-lev]')].filter(c=>c.checked).map(c=>+c.dataset.lev);
function markLeverWarning(){
  const n = leverPick().length, w = document.getElementById('leverWarn');
  document.querySelectorAll('[data-lev]').forEach(c=>c.parentElement.classList.toggle('on', c.checked));
  // ⚠️ The one setting on this panel with a game-theory cost, so it says so out loud.
  // The randomised hierarchy is what keeps the meta unsolvable — a composite score was
  // rejected for exactly this reason. Fewer levers = a more deterministic objective.
  if(n === 0){ w.style.display=''; w.textContent='At least one tiebreaker has to stay in the draw.'; return; }
  if(n < 3){
    w.style.display='';
    w.innerHTML = n===1
      ? '⚠️ <b>One lever is a solved game.</b> With only one objective live, optimising against it is strictly dominant and the whole league converges on the same move. The randomisation across four is what stops that.'
      : '⚠️ <b>Two levers is most of the way to a solved game.</b> The draw exists so no single objective can be optimised against; the fewer that are live, the more predictable the target.';
  } else w.style.display='none';
}
