async function submitLeg(){
  const e=document.getElementById('err'); e.className='err'; e.textContent='';
  const sp=fSport.value, id=fGame.value, mk=fMkt.value, side=fSide.value;
  const typedPrice=fPrice.value.trim() ? favPrice(fPrice.value) : null, line=+fLine.value;
  const g=(GAMES[sp]||[]).find(x=>x.id===id);
  if(!g) return e.textContent='Pick a game.';
  if(typedPrice!==null && !Number.isFinite(typedPrice)) return e.textContent='The optional price check has to be a whole American number, like -175.';
  if(mk==='other' && typedPrice===null) return e.textContent='Other markets are self-priced, so enter the DraftKings price.';
  if(mk!=='ml' && !fLine.value) return e.textContent='Number is required for that market.';
  // mirrors the Worker: an "other" leg that doesn't say what it is cannot be graded
  if(mk==='other' && !fProp.value.trim())
    return e.textContent='Describe the bet — an "other" leg needs to say what it actually is.';
  const label = legLabel(mk, side, line, fProp.value, g.short);
  const pick = {sport:sp, eventId:id, game:g.short, mkt:mk, side, line: mk==='ml'?0:line,
    ...(typedPrice===null?{}:{typedPrice}), label, prop: fProp.value||null,
    // ⚠️ Kickoff, straight off the ESPN game you picked. This is what schedules the
    // closing-price capture — event ids don't line up between ESPN and the odds source,
    // so this timestamp is the only thing that tells the cron WHEN to snap. A leg
    // without it never gets a close.
    startsAt: g.start || null};
  const btn=document.getElementById('save'); btn.disabled=true;
  try{
    const proposal = await wPost('/bozo/pick', {captureVersion:1, pick});
    const agreement = proposal.agreement && proposal.agreement.needsConfirmation
      ? `\n\nYour check was ${fmtPrice(proposal.agreement.typedPrice)}; the captured price is ${fmtPrice(proposal.agreement.capturedPrice)} (${proposal.agreement.probabilityPointDifference.toFixed(2)} probability points apart).`
      : '';
    if(!window.confirm(proposal.echo + agreement + '\n\nNothing has been submitted yet. Submit this exact captured quote?')){
      e.textContent='Nothing submitted.'; btn.disabled=false; return;
    }
    const res = await wPost('/bozo/pick', {confirm:proposal.confirm_code});
    e.className='err ok';
    e.textContent = res.placed ? 'In — and that was the last leg. Ticket is locked.' : 'Submitted.';
    await refresh();
  }catch(err){ e.className='err'; e.textContent=err.message; }
  btn.disabled=false;
}

/* ---------------- the ticket, as a parlay slip ----------------
   Legs are listed in SUBMISSION order, not roster order. That is not decoration:
   Last In is one of the four levers, so the bottom leg on the slip is the one
   currently exposed to it, and you can see that without reading a timestamp. */
function paintSlip(players, picks, status, live){
  const stake = settings().stake ?? 50;
  const res = S.results || {};
  const rows = players.map(p=>({p, x:picks[kEnc(p)]||{}, r:res[kEnc(p)]||{}}))
    .sort((a,b)=>{
      const ai=a.x.price!=null, bi=b.x.price!=null;
      if(ai!==bi) return ai?-1:1;                       // legs in first, blanks last
      if(ai) return (a.x.ts||0)-(b.x.ts||0);            // then by when they landed
      return a.p.localeCompare(b.p);
    });
  const graded = status==='graded';
  const open = status==='open';
  // Index of the newest leg in the sorted list — the one Last In is looking at right now.
  const belt = beltHolder();          // same rule the season board uses
  const withLegs = rows.filter(r=>r.x.price!=null);
  const lastInIdx = withLegs.length ? withLegs.length - 1 : -1;
  const nIn = live.length;
  const html = rows.map((row,i)=>{
    const {p,x,r} = row;
    const inPool = x.price!=null;
    let state = !inPool ? 'empty'
      : graded ? (r.won===true?'won':r.won===false?'lost':'void')
      : 'on';
    const cls = [ 'leg', state,
      (ME && p===ME.name) ? 'mine' : '',
      (S.bozo && playerName(S.bozo)===p) ? 'bz' : '' ].filter(Boolean).join(' ');
    const mark = state==='won' ? '✓' : state==='lost' ? '✕' : state==='void' ? '—' : (i+1);
    if(!inPool){
      // ⚠️ Bozo Royale: a chopped player is not "waiting to submit", they are OUT — and
      // they stay visible rather than vanishing, because the ledger, the chart and the
      // pot all still involve them. The ticket itself shrinks as the roster does; it
      // never assumed eight rows and must not start now.
      const rs = royaleOf(p);
      if(rs && rs.alive === false)
        return `<li class="leg dead"><span class="mk">✝</span>
          <span><span class="who2">${esc(teamOf(p))}${chute(p)}${belt===p?'<span class="beltcrest" role="img" aria-label="Wearing the belt"></span>':''}</span>
          <span class="sel">chopped in week ${rs.eliminatedWeek ?? '?'} · funds the ticket, doesn't bet on it</span></span>
          <span class="rt"><span class="pxv dead">OUT</span></span></li>`;
      return `<li class="${cls}"><span class="mk">${mark}</span>
        <span><span class="who2">${esc(teamOf(p))}</span>
        <span class="sel">no leg yet</span></span>
        <span class="rt"><span class="pxv">—</span></span></li>`;
    }
    const sub = `${SPORTS[x.sport]?SPORTS[x.sport].n:esc(x.sport)} · ${esc(x.game)}`
      + (x.mkt==='prop' ? ' · prop' : x.mkt==='other' ? ' · other' : '')
      + (r.actual!=null ? ` · finished ${r.actual}` : '');
    /* ⚠️ NAME THE EXPOSURE, don't imply it. The legs are listed in submission order and a
       comment in this file has always said the bottom one is the one Last In would pick —
       but nothing on screen said so, which left the single most actionable fact on an
       open board as something you had to already know. While the board is open the newest
       leg wears it, and whoever it is should be able to see that without counting rows. */
    const isLastIn = open && inPool && i === lastInIdx;
    return `<li class="${cls}"><span class="mk">${mark}</span>
      <span><span class="who2">${esc(teamOf(p))}${chute(p)}${belt===p?'<span class="beltcrest" role="img" aria-label="Wearing the belt"></span>':''}</span>
      <span class="sel">${esc(x.label)}${isLastIn?'<span class="lastin">last in</span>':''}</span>
      <span class="mkt">${sub} · ${priceSourceBadge(x)}</span></span>
      <span class="rt"><span class="pxv">${x.price>0?'+':''}${x.price}</span>
      <span class="tin">${when(x.ts)}</span></span></li>`;
  }).join('');

  let odds='—', pay='—';
  if(nIn){
    const d = live.reduce((a,x)=>a*dec(x.price),1);
    odds = amer(d); pay = '$'+Math.round(d*stake).toLocaleString();
  }

  /* ⚠️ THE DISPLAYED PRICE IS WRONG WHENEVER TWO LEGS SHARE A GAME, and it used to say
     so nowhere. Multiplying the leg prices is price arithmetic, not a correlation-aware
     joint outcome model — fine for eight independent games, false the moment two legs
     are on one event, because DraftKings reprices correlated SGP legs. The product is an
     UPPER BOUND on the payout, often badly.

     ⚠️ The better fix is to show DK's actual SGP price for the constructed ticket. That
     is not available to us: it needs DK's bet-slip pricing endpoint and DK has no public
     API, and no aggregator reprices an arbitrary same-game combination either. So the
     honest option is the only available one — label it, and say why. */
  const byEvent = {};
  for(const x of live) (byEvent[x.eventId] = byEvent[x.eventId] || []).push(x);
  const sgp = Object.entries(byEvent).filter(([,g])=>g.length>1)
    .map(([,g])=>({ game:g[0].game, legs:g.length, who:g.map(y=>teamOf(y.p)) }));
  const indicative = sgp.length > 0;
  const sgpNote = indicative
    ? `<div class="sgpwarn"><b>Indicative price only.</b> `
      + sgp.map(s=>`${s.legs} legs on ${esc(s.game)} (${s.who.map(esc).join(', ')})`).join('; ')
      + ` — that makes this a same-game parlay, and DraftKings reprices correlated legs. `
      + `The number above is the product of the individual prices, which is an upper bound, not the payout.</div>`
    : '';

  const stamp = status==='open'?'open':status==='placed'?'placed':'graded';
  document.getElementById('board').innerHTML =
    `<div class="stamp ${stamp}">${stamp}</div>
     <div class="slip-hd"><span class="t">Parlay · ${nIn} leg${nIn===1?'':'s'}</span>
       <span class="s">Week ${S.week||1} · ${esc(league()?.name || 'Data Dawgs')}`
       + (isDemo()?' · <span class="chip demo">DEMO · SIMULATED</span>':'') + `</span></div>
     <ul class="legs">${html}</ul>
     <div class="slip-ft">
       <div><div class="lil">Legs</div><div class="big" id="tLegs">${nIn}</div></div>
       <div><div class="lil">Parlay price${indicative?' <span class="ind">indicative</span>':''}</div>
         <div class="big" id="tOdds">${odds}</div></div>
       <div><div class="lil">$${stake} returns${indicative?' <span class="ind">at most</span>':''}</div>
         <div class="big" id="tPay">${pay}</div></div>
     </div>${sgpNote}`;
}

/* ---------------- diagnostics ----------------
   Every number here is DERIVED at read time from prices already on the board —
   nothing is persisted, for the same reason the player sheets derive CLV on the
   fly: the SD table will be retuned and stored derivatives would rot.

   ⚠️ The simulation introduces NO new assumption. It draws each leg's result from
   actual ~ Normal(expected(x), sdOf(x)) — the exact model the Worst Beat index
   already uses to score the week. That model is self-consistent by construction:
   P(the leg clears its number) works out to precisely the de-vigged price that was
   typed in. So the sim is the scoring rules, run forward.

   ⚠️ What it does NOT model: correlation. Legs are drawn independently. Two legs
   on the same game are not independent, and the flag under the table says so.
   ⚠️ Prop SD is line×0.55 — the brief's own words are "the weakest number in the
   build." Prop legs are marked in the table. */
const SIMS = 20000;
let simKey = '', simOut = null;

function gauss(){
  let u=0,v=0; while(u===0)u=Math.random(); while(v===0)v=Math.random();
  return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);
}
function shuffled(a){
  a=a.slice(); for(let i=a.length-1;i>0;i--){ const j=(Math.random()*(i+1))|0; const t=a[i]; a[i]=a[j]; a[j]=t; }
  return a;
}
const devig = px => Math.min(.98, Math.max(.02, imp(px)-.022));

function simulate(live, levers){
  const n = live.length;
  const res = S.results || {};
  const L = live.map(x=>{
    const r = res[kEnc(x.p)] || {};
    // Real CLV where the close has been captured, null where it hasn't. See the lever
    // branch below for why the difference matters.
    const pC = devigP(r.close, r.closeOpp), pE = devigP(x.price, x.entryPriceOpp);
    return {
      sd: sdOf(x), base: x.mkt==='ml' ? 0 : x.line, exp: expected(x),
      under: dirOf(x)==='under', odds: imp(x.price), last: x.ts||0,
      clv: (pC==null||pE==null) ? null : (pC-pE)
    };
  });
  const win=new Array(n).fill(0), bz=new Array(n).fill(0), solo=new Array(n).fill(0);
  const named=live.map(()=>({}));
  const idx=new Array(n), lost=[];
  let cash=0;
  for(let s=0;s<SIMS;s++){
    lost.length=0;
    for(let i=0;i<n;i++){
      const l=L[i], actual = l.exp + l.sd*gauss();
      // the Bozo Index, exactly as decide() computes it
      idx[i] = (l.under ? (actual-l.exp) : (l.exp-actual)) / l.sd;
      if(l.under ? actual < l.base : actual > l.base) win[i]++; else lost.push(i);
    }
    if(!lost.length){ cash++; continue; }
    if(lost.length===1) solo[lost[0]]++;
    let pool=lost.slice(), why=null;
    for(const li of shuffled(levers)){
      const k=LEVERS[li].k;
      let surv;
      if(k==='clv'){
        /* ⚠️ THIS COMMENT USED TO SAY "no closing prices are captured yet". They are now,
           so CLV carries real information for any leg whose close has been snapped — and
           randomising it would delete that. But a close only exists once the market has
           closed, and this sim also runs on an OPEN board where the games have not
           started. So: rank on real CLV where it is known, and fall back to uniform over
           whoever is left when it genuinely isn't. Uniform is what "no information"
           actually means; a constant would silently drop a live lever from the draw. */
        const known = pool.filter(i=>L[i].clv!=null);
        if(known.length){
          let mx=-Infinity; for(const i of known){ const v=-L[i].clv; if(v>mx) mx=v; }
          surv=known.filter(i=>-L[i].clv===mx);
        }else{
          surv=[pool[(Math.random()*pool.length)|0]];
        }
      }else{
        const f = k==='odds' ? (i=>L[i].odds) : k==='beat' ? (i=>idx[i]) : (i=>L[i].last);
        let mx=-Infinity; for(const i of pool){ const v=f(i); if(v>mx) mx=v; }
        surv=pool.filter(i=>f(i)===mx);
      }
      if(surv.length<pool.length || surv.length===1){ pool=surv; why=li; }
      if(pool.length===1) break;
    }
    const b=pool[0]; bz[b]++;
    if(why!==null) named[b][why]=(named[b][why]||0)+1;
  }
  return {
    n, sims:SIMS, cash:cash/SIMS,
    win: win.map(c=>c/SIMS), bozo: bz.map(c=>c/SIMS), solo: solo.map(c=>c/SIMS),
    by: named.map((m,i)=>{ let best=null,bc=0;
      for(const k in m) if(m[k]>bc){ bc=m[k]; best=+k; }
      return best===null ? null : {name:LEVERS[best].name, share: bc/Math.max(1,bz[i])}; })
  };
}

// One definition of "is the cached sim still the right sim". Used by paintDiag to
// decide whether to re-run, and by Toto's context to decide whether it may quote it.
// ⚠️ The close is part of the key now that CLV feeds the sim. Without it, a close landing
// at kickoff would leave a cached run that had ranked Worst CLV at random still on screen,
// looking freshly computed.
const simKeyFor = (live, levers, status) =>
  live.map(x=>{ const r=(S.results||{})[kEnc(x.p)]||{};
    return `${x.p}:${x.price}:${x.ts}:${x.line}:${x.mkt}:${x.side}:${r.close??''}:${r.closeOpp??''}`; }).join('|')
  + '#' + levers.join(',') + '#' + status;

const pct = v => (v*100).toFixed(v>=.1?0:1)+'%';
function meter(v, risk){
  return `<span class="meter${risk?' risk':''}"><i style="width:${Math.max(2,Math.min(100,v*100)).toFixed(1)}%"></i></span>`;
}

/* One server-written hierarchy per locked week. Every ledger row for a week carries
   the same order; taking the first is a receipt lookup, not a reconstruction. */
function paintHierarchyHistory(){
  const out=document.getElementById('hierHistory'), meta=document.getElementById('hierHistoryMeta');
  const byWeek=new Map();
  Object.values(S.ledger||{}).forEach(r=>{
    if(r && Number.isFinite(+r.week) && Array.isArray(r.tiebreak) && !byWeek.has(+r.week))
      byWeek.set(+r.week, r.tiebreak);
  });
  if(Array.isArray(S.order)) byWeek.set(+(S.week||1), S.order);
  const rows=[...byWeek.entries()].sort((a,b)=>b[0]-a[0]);
  meta.textContent=rows.length ? rows.length+' locked week'+(rows.length===1?'':'s') : '';
  if(!rows.length){ out.innerHTML='<div class="dash-empty">The first locked ticket will write the first hierarchy here.</div>'; return; }
  out.innerHTML=`<table class="hier-table"><thead><tr><th>Week</th><th>1st lever</th><th>2nd lever</th><th>3rd lever</th><th>4th lever</th></tr></thead><tbody>`
    + rows.map(([wk,ord])=>`<tr><td>Week ${wk}</td>`
      + [0,1,2,3].map(i=>`<td><span class="hier-rank">${i+1}</span>${esc((LEVERS[ord[i]]||{}).name||'—')}</td>`).join('')
      + `</tr>`).join('') + `</tbody></table>`;
}

const DX={lid:null,wired:false};
function dxInit(){
  if(!CLV.data) return;
  const player=document.getElementById('dxPlayer'), sport=document.getElementById('dxSport');
  const from=document.getElementById('dxFrom'), to=document.getElementById('dxTo');
  if(DX.lid!==LID){
    DX.lid=LID;
    player.innerHTML='<option value="all">All players</option>'+CLV.players.map(p=>`<option value="${esc(p)}">${esc(teamOf(p))}</option>`).join('');
    sport.innerHTML='<option value="all">All sports</option>'+CLV.sports.map(s=>`<option value="${esc(s)}">${esc(String(s).toUpperCase())}</option>`).join('');
    const weeks=[...new Set((CLV.data.legs||[]).map(l=>+l.week))].sort((a,b)=>a-b);
    const opts=weeks.map(w=>`<option value="${w}">Week ${w}</option>`).join('');
    from.innerHTML=opts; to.innerHTML=opts;
    if(weeks.length){ from.value=weeks[0]; to.value=weeks[weeks.length-1]; }
    document.getElementById('dxWindow').value='all';
  }
  if(!DX.wired){
    DX.wired=true;
    ['dxPlayer','dxWindow','dxFrom','dxTo','dxSport','dxGroup'].forEach(id=>{
      document.getElementById(id).addEventListener('change',()=>{
        if(id==='dxFrom'||id==='dxTo') document.getElementById('dxWindow').value='custom';
        paintDiagnosticsExplorer();
      });
    });
  }
}
function dxRows(){
  const player=document.getElementById('dxPlayer').value, sport=document.getElementById('dxSport').value;
  const win=document.getElementById('dxWindow').value;
  let rows=(CLV.data.legs||[]).filter(l=>(player==='all'||l.player===player)&&(sport==='all'||l.sport===sport));
  const max=Math.max(0,...rows.map(l=>+l.week||0));
  if(win==='last5') rows=rows.filter(l=>+l.week>=max-4);
  if(win==='custom'){
    const a=+document.getElementById('dxFrom').value, b=+document.getElementById('dxTo').value;
    rows=rows.filter(l=>+l.week>=Math.min(a,b)&&+l.week<=Math.max(a,b));
  }
  rows.sort((a,b)=>(+a.week-+b.week)||String(a.entrySubmittedAt||'').localeCompare(String(b.entrySubmittedAt||'')));
  if(win==='last24') rows=rows.slice(-24);
  return rows;
}
function dxSummary(rows){
  const graded=rows.filter(l=>l.result==='win'||l.result==='loss');
  const measurable=graded.filter(clvGraded);
  const wins=graded.filter(l=>l.result==='win').length;
  const expected=measurable.reduce((s,l)=>s+clvDevig(l.closePrice,l.closePriceOpp),0);
  const clv=measurable.reduce((s,l)=>s+clvDevig(l.closePrice,l.closePriceOpp)-clvDevig(l.entryPrice,l.entryPriceOpp),0);
  return {picks:rows.length,graded,wins,losses:graded.length-wins,measurable,
    expected,delta:wins-expected,clv:measurable.length?clv/measurable.length:null};
}
function paintDiagnosticsExplorer(){
  if(!CLV.data || view()!=='diagnostics') return;
  dxInit();
  const rows=dxRows(), s=dxSummary(rows), tile=(l,b,sub)=>`<div><div class="lil">${l}</div><div class="big">${b}</div><div class="tm">${sub||''}</div></div>`;
  document.getElementById('dxMeta').textContent=`${rows.length} pick${rows.length===1?'':'s'} in this slice`;
  document.getElementById('dxTiles').innerHTML=
    tile('Picks',s.picks,`${s.graded.length} graded`)+tile('Record',`${s.wins}–${s.losses}`,s.graded.length?`${(s.wins/s.graded.length*100).toFixed(1)}% won`:'nothing graded')+
    tile('Expected wins',s.measurable.length?s.expected.toFixed(1):'—',`${s.measurable.length} with usable closes`)+
    tile('Over / under expected',s.measurable.length?`${s.delta>=0?'+':''}${s.delta.toFixed(1)}`:'—','wins minus closing-line expectation')+
    tile('Average CLV',s.clv==null?'—':`${s.clv>=0?'+':''}${(s.clv*100).toFixed(2)}pp`,'de-vigged close minus entry')+
    tile('CLV coverage',s.picks?`${s.measurable.length} / ${s.picks}`:'—','missing data is never filled as zero');
  if(!rows.length){ document.getElementById('dxChart').innerHTML='<div class="dash-empty">No picks match these filters.</div>'; document.querySelector('#dxTable tbody').innerHTML=''; return; }
  const group=document.getElementById('dxGroup').value;
  const key=l=>group==='player'?teamOf(l.player):group==='sport'?String(l.sport||'Unknown').toUpperCase():group==='market'?String(l.mkt||'other').toUpperCase():'Week '+l.week;
  const buckets=new Map(); rows.forEach(l=>{ const k=key(l); if(!buckets.has(k)) buckets.set(k,[]); buckets.get(k).push(l); });
  const sums=[...buckets].map(([k,v])=>({k,...dxSummary(v)})).sort((a,b)=>b.picks-a.picks||a.k.localeCompare(b.k));
  const maxDelta=Math.max(1,...sums.map(x=>Math.abs(x.delta)));
  document.getElementById('dxChart').innerHTML=sums.map(x=>`<div class="dash-bar${x.delta<0?' bad':''}"><span>${esc(x.k)}</span><span class="track"><i style="width:${Math.max(3,Math.abs(x.delta)/maxDelta*100).toFixed(1)}%"></i></span><span class="val">${x.measurable.length?(x.delta>=0?'+':'')+x.delta.toFixed(1):'—'}</span></div>`).join('');
  document.querySelector('#dxTable tbody').innerHTML=`<tr><th>${esc(group)}</th><th>Picks</th><th>W–L</th><th>Expected W</th><th>vs expected</th><th>Avg CLV</th><th>CLV n</th></tr>`+
    sums.map(x=>`<tr><td class="who">${esc(x.k)}</td><td>${x.picks}</td><td>${x.wins}–${x.losses}</td><td>${x.measurable.length?x.expected.toFixed(1):'—'}</td><td class="px">${x.measurable.length?(x.delta>=0?'+':'')+x.delta.toFixed(1):'—'}</td><td class="px ${x.clv==null?'':x.clv>=0?'clvup':'clvdn'}">${x.clv==null?'—':(x.clv>=0?'+':'')+(x.clv*100).toFixed(2)+'pp'}</td><td>${x.measurable.length}</td></tr>`).join('');
  const losers=rows.filter(l=>l.result==='loss'), badClv=losers.filter(l=>clvGraded(l)&&clvDevig(l.closePrice,l.closePriceOpp)<clvDevig(l.entryPrice,l.entryPriceOpp)).length;
  document.getElementById('dxNote').innerHTML=`${losers.length} loss${losers.length===1?'':'es'} in this slice${losers.length?`; ${badClv} also had negative measured CLV`:''}. Positive result delta with flat CLV is more consistent with good luck than proven skill; positive CLV with ordinary results is the stronger price-quality signal. Measured CLV uses captured DraftKings prices at entry and close; self-priced legs are excluded.`;
}

function paintDiag(live, players, status){
  const card=document.getElementById('diagCard');
  if(!live.length){
    card.style.display='';
    card.classList.add('empty');   // the empty note becomes the felt plaque
    document.getElementById('dgMeta').textContent='';
    document.getElementById('dgTiles').innerHTML='';
    document.getElementById('dgFlags').innerHTML='';
    document.querySelector('#dgTable tbody').innerHTML='';
    document.getElementById('dgNote').textContent =
      'Nothing to measure yet. The first leg in turns this on.';
    return;
  }
  card.style.display='';
  card.classList.remove('empty');
  const st = settings(), levers = (st.levers && st.levers.length) ? st.levers : [0,1,2,3];
  const stake = st.stake ?? 50;
  const key = simKeyFor(live, levers, status);
  if(key!==simKey){ simKey=key; simOut=simulate(live,levers); }
  const R=simOut;

  const offDec  = live.reduce((a,x)=>a*dec(x.price),1);
  const fairDec = 1/live.reduce((a,x)=>a*devig(x.price),1);
  const hold    = 1 - offDec/fairDec;                 // what the book keeps
  const ev      = stake*(offDec*R.cash - 1);

  const tile=(lil,big,sub,cost)=>`<div><div class="lil">${lil}</div><div class="big${cost?' cost':''}">${big}</div>`
    + (sub?`<div class="tm">${sub}</div>`:'') + `</div>`;
  document.getElementById('dgMeta').textContent =
    R.sims.toLocaleString()+' simulations · re-run whenever a leg changes';
  document.getElementById('dgTiles').innerHTML =
    tile('Ticket cashes', pct(R.cash), `all ${R.n} legs land`) +
    tile('Parlay price', amer(offDec), 'what you are laying') +
    tile('Fair price', amer(fairDec), 'de-vigged, same legs') +
    tile("Book's edge", pct(hold), 'compounded across the legs', 1) +
    tile('EV on $'+stake, (ev<0?'−$':'$')+Math.abs(ev).toFixed(2), 'per ticket, long run', 1) +
    tile('Legs in', R.n+' / '+players.length, status);

  const LV = leverStandings(live);

  // ---- flags: the things the numbers above are quietly assuming ----
  const flags=[];
  const byEvent={};
  live.forEach(x=>{ const k=x.eventId||x.game; if(k){ (byEvent[k]=byEvent[k]||[]).push(x); } });
  const stacked = Object.values(byEvent).filter(g=>g.length>1);
  if(stacked.length){
    const who = stacked.map(g=>`${esc(g[0].game)} (${g.map(x=>esc(teamOf(x.p))).join(', ')})`).join('; ');
    flags.push(`<div class="flag corr"><span>⚠</span><span><b>Correlated legs — the cash number above is wrong.</b>
      ${who}. The simulation draws every leg independently, which is false for legs on the same game.
      If they move together the real cash probability is <b>higher</b> than shown; if they fight each other it is lower.
      Nothing here corrects for it.</span></div>`);
  }
  const props = live.filter(x=>x.mkt==='prop' || x.mkt==='other');
  if(props.length)
    flags.push(`<div class="flag"><span>⚠</span><span><b>${props.length} soft-SD leg${props.length===1?'':'s'} (prop or other)</b>
      — ${props.map(x=>esc(teamOf(x.p))).join(', ')}. Prop standard deviation is <code>line × 0.55</code>, a placeholder the
      brief calls the weakest number in the build. Their Worst Beat exposure is the softest column on this page.</span></div>`);
  // ⚠️ Ordered first on purpose: an integrity flag outranks a modelling caveat.
  const fl = flaggedRows();
  if(fl.length){
    const hard = fl.filter(x=>x.f.level==='hard').length;
    flags.push(`<div class="flag corr"><span>⚠</span><span><b>${fl.length} leg${fl.length===1?'':'s'} flagged for review</b>`
      + (hard?` (${hard} well outside plausible line movement)`:'')
      + `. The submitted price is a long way from where the market closed. That is <b>not</b> an accusation — a real steam move can do it — but it is worth a look:<br>`
      + fl.slice(0,6).map(x=>`· <b>${esc(teamOf(x.r.player))}</b> w${x.r.week} ${esc(x.r.label)} — ${esc(x.f.why)}`).join('<br>')
      + (fl.length>6?`<br>· …and ${fl.length-6} more, on the player sheets.`:'')
      + `</span></div>`);
  }
  /* ⚠️ THIS FLAG USED TO SAY "no closing prices are captured yet". They are now — the
     kickoff capture ships — so the honest statement is per-leg rather than blanket: a
     close exists for some legs and not others, and only a leg with BOTH sides at BOTH
     ends can be de-vigged into a CLV at all. Say which, and how many. */
  if(levers.includes(3)){
    const withClv = live.filter(x=>{ const r=(S.results||{})[kEnc(x.p)]||{};
      return devigP(r.close, r.closeOpp)!=null && devigP(x.price, x.entryPriceOpp)!=null; }).length;
    if(withClv === 0)
      flags.push(`<div class="flag"><span>⚠</span><span><b>Worst CLV can't be measured on this board yet.</b>
        The closes are captured at kickoff, so until the games start there is nothing to compare against — in the
        simulation CLV picks uniformly among whoever is still tied, which is what "no information" actually means.
        It fills in once the snapshot lands.</span></div>`);
    else if(withClv < live.length)
      flags.push(`<div class="flag"><span>⚠</span><span><b>Worst CLV is measured on ${withClv} of ${live.length} legs.</b>
        The rest have no capturable close, or only one side of one — and a price with no opposite side can't be
        de-vigged, so it is not a CLV. In the simulation this lever ranks the legs it can and passes when it can't;
        it never guesses at the others.</span></div>`);
  }
  if(levers.length<4)
    flags.push(`<div class="flag"><span>⚠</span><span><b>Only ${levers.length} of 4 levers are in the draw.</b>
      Fewer levers is a more deterministic objective, which is the thing the randomised hierarchy exists to prevent.</span></div>`);
  document.getElementById('dgFlags').innerHTML = flags.join('');

  /* One leg's CLV cell.
     ⚠️ Three states, not two. A captured close gives a real number. NO close is "no
     close" — not zero, because zero is a claim that the market did not move, and this
     column used to say TBD for everything precisely so that claim was never made by
     accident. One side only is its own state again: the price is there but cannot be
     de-vigged, and a raw-implied number here would be wrong by roughly the whole hold
     while looking exactly as authoritative as a real one. */
  const clvText = x => {
    const r = (S.results||{})[kEnc(x.p)] || {};
    const pC = devigP(r.close, r.closeOpp), pE = devigP(x.price, x.entryPriceOpp);
    if(pC != null && pE != null){
      const v = (pC - pE) * 100;
      // ⚠️ NOT .pos/.neg — .pos is already the reel position label ("1ST"), and the
      // carnival skin restyles it. A CLV number would silently inherit both.
      return `<span class="${v>=0?'clvup':'clvdn'}" title="de-vigged close ${(pC*100).toFixed(1)}% − de-vigged entry ${(pE*100).toFixed(1)}%">`
        + `${v>0?'+':''}${v.toFixed(2)} pts</span>`;
    }
    if(r.close != null && r.closeOpp == null)
      return `<span title="Only one side of the close was captured, so it can't be de-vigged.">one side only</span>`;
    if(r.closeUnavailableReason)
      return `<span title="${esc(r.closeUnavailableReason)}">no close</span>`;
    return `awaiting close`;
  };

  /* One lever cell. A placement is printed only where that lever can actually rank the
     leg; where it can't, the cell says what it is waiting for and takes an em dash, which
     is a different statement from ranking last. `hot` marks the leg the lever currently
     stops on — for Last In that is the BOTTOM of the printed order, not the top. */
  const lvCell = (k, i, lbl, val, muted) => {
    const r = LV.rank[k][i];
    return `<td class="lv${muted?' unr':''}" data-l="${lbl}">`
      + (r ? `<b class="lvr${LV.holds[k][i]?' hot':''}"${LV.holds[k][i]
              ? ' title="This is where the lever stops right now."' : ''}>${ordinal(r)}</b>` : `<b class="lvr">—</b>`)
      + `<span class="lvv">${val}</span></td>`;
  };
  // A lever the league has taken out of the draw still gets its column — knowing it is
  // NOT in play is as load-bearing as knowing where you stand on one that is.
  const outCell = lbl => `<td class="lv unr" data-l="${lbl}"><b class="lvr">—</b><span class="lvv">not in the draw</span></td>`;

  // ---- per-player table ----
  /* ⚠️ ONE list of column headings, written into the <th> AND into every cell's data-l.
     On a phone this table is not a table — the header row is hidden and each cell draws
     its own label from data-l (see the #dgTable rules in the ≤640px block), because ten
     columns scrolled sideways with the header gone is a value on screen with no way to
     tell what it is. Two copies of these strings would drift, and the drifted one would
     be the label a phone reads. */
  const LVL = ['I · Shortest odds','II · Worst beat','III · Last in','IV · Worst CLV'];
  const order = live.map((x,i)=>i).sort((a,b)=>R.bozo[b]-R.bozo[a]);
  document.querySelector('#dgTable tbody').innerHTML =
    `<tr><th>Who</th><th>Leg</th><th>Leg wins</th><th>Bozo odds</th><th>Killed it alone</th>`
    + LVL.map(l=>`<th>${l}</th>`).join('')
