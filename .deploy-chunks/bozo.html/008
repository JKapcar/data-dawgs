 ticket is placed — resets your timestamp and your price','fixed') +
    row('The lock','the ticket is placed when the last leg lands; that moment is the close','fixed') +
    row('Tiebreak','fresh random hierarchy of all four levers, drawn server-side each week','fixed');
  document.getElementById('lgNote').textContent = cfg.updatedTs
    ? `Band last set by ${cfg.updatedBy||'?'} · ${new Date(cfg.updatedTs).toLocaleDateString()} — enforced by the server, so the dial is the rule.`
    : 'Band is at its defaults — enforced by the server, so the dial is the rule.';

  const adm = document.getElementById('lgAdmin');
  adm.style.display = isManager() ? '' : 'none';
  if(isManager() && !lgDirty) fillSettings();
  paintRoster();
}

function settings(){ return league()?.settings || {stake:50,allowEdit:true,lockRule:'all',lockCount:0,levers:[0,1,2,3],format:'standard',buyback:0,formatLocked:false,synthetic:false}; }
// Which ruleset this league runs. Standard names a bozo who plays again next week;
// Bozo Royale eliminates them. Everything else about a leg is identical.
const isRoyale = () => settings().format === 'royale';
const isDemo   = () => settings().synthetic === true;
/* Live Royale state for one player, straight off the league node. Null in Standard,
   where nobody is ever out. */
const royaleOf = p => isRoyale() ? (((S.royale||{}).status||{})[kEnc(p)] || null) : null;
const royaleAliveNames = () => names().filter(p=>{ const r=royaleOf(p); return !r || r.alive !== false; });
/* ⚠️ THE PARACHUTE. Warzone rules: get chopped once and you are re-deployed straight back
   onto the next ticket — automatically, no prompt, nothing to accept. What you carry
   afterwards is this, and it means the next chop is the one that ends you.

   Read from `redeployed` with a fallback to the old `boughtBack`, because leagues written
   before the rename are still mid-season and their history is the same history. */
const hasChute = p => {
  const r = royaleOf(p); if(!r) return false;
  const back = r.redeployed || r.boughtBack || [];
  return back.length > 0;
};
// Suffix, not a replacement for the name — it has to compose with team names and YOU tags.
const chute = p => hasChute(p) ? ' <span class="chute" title="Re-deployed. One chop from out.">🪂</span>' : '';

function fillSettings(){
  const bd = band(), st = settings(), lg = league();
  document.getElementById('sName').value = lg?.name || '';
  document.getElementById('sMgr').innerHTML =
    allAccounts().map(n=>`<option${n===lg?.manager?' selected':''}>${esc(n)}</option>`).join('');
  document.getElementById('sStake').value = st.stake;
