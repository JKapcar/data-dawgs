  if(!isManager()){ body.innerHTML=''; return; }
  const mine = names(), picks = S.picks||{}, open = (S.status||'open')==='open';
  const mgr = league()?.manager;
  body.innerHTML = mine.map(n=>{
    const hasLeg = !!picks[kEnc(n)];
