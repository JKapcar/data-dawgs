/* ---- editable settings ---- */
.setgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px 18px;margin:6px 0 4px}
.setgrid .f{gap:5px}
.lev{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.lev label{display:flex;align-items:center;gap:6px;border:1px solid var(--grid);border-radius:8px;
  padding:7px 11px;cursor:pointer;font:600 12.5px system-ui;color:var(--ink-2);text-transform:none;letter-spacing:0}
.lev label.on{border-color:var(--accent);color:var(--ink-1);background:color-mix(in srgb, var(--accent) 8%, transparent)}
.warnbox{border-left:3px solid var(--warn);background:color-mix(in srgb, var(--warn) 9%, transparent);
  padding:10px 13px;border-radius:0 8px 8px 0;font-size:13px;margin:10px 0 0;color:var(--ink-1)}
.ros input.team{width:150px;font:600 13px system-ui;padding:5px 8px}
/* ---- roster / invite management ---- */
.ros{display:grid;grid-template-columns:1fr auto auto;gap:8px 10px;align-items:center;
  padding:9px 0;border-bottom:1px solid var(--grid);font-size:14px}
.ros:last-of-type{border-bottom:0}
.ros .st{font:700 10px/1 ui-monospace,monospace;letter-spacing:.9px;text-transform:uppercase;
  padding:3px 7px;border-radius:4px;white-space:nowrap}
.ros .st.yes{background:color-mix(in srgb, var(--good) 16%, transparent);color:var(--good)}
.ros .st.no{background:color-mix(in srgb, var(--warn) 18%, transparent);color:var(--warn)}
.linkout{margin-top:10px;padding:12px 14px;border-radius:9px;
  background:color-mix(in srgb, var(--accent) 8%, transparent);border-left:3px solid var(--accent)}
.linkout code{display:block;font:12px ui-monospace,monospace;word-break:break-all;
  margin:7px 0;color:var(--ink-1)}
@media(max-width:640px){ .ros{grid-template-columns:1fr auto;row-gap:6px} .ros .who{grid-column:1/-1} }

/* ---- streamlined Bozo sheets ---- */
#bozoApp{display:flex;flex-direction:column}
#bozoApp>.playbill{order:0}
.playbill .snav{position:sticky;top:0;z-index:18}
.playbill .snav button{flex:1 1 25%;justify-content:center;min-width:130px;text-align:center}
.playbill .snav button .who{font-size:11px;letter-spacing:.065em}
.hier-grid{overflow:auto;margin-top:10px}
.hier-table{min-width:620px;width:100%;border-collapse:separate;border-spacing:0;font-variant-numeric:tabular-nums}
.hier-table th,.hier-table td{padding:10px 12px;border-right:1px solid var(--grid);border-bottom:1px solid var(--grid);text-align:left}
.hier-table th{font:750 10px/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
.hier-table td:first-child,.hier-table th:first-child{position:sticky;left:0;background:var(--surface-1);z-index:1;font-weight:800}
.hier-table td:last-child,.hier-table th:last-child{border-right:0}
.hier-table tr:last-child td{border-bottom:0}
.hier-rank{display:inline-grid;place-items:center;width:20px;height:20px;margin-right:7px;border-radius:50%;background:var(--grid);font:800 10px/1 ui-monospace,monospace;color:var(--ink-2)}
.dash-controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:12px 0 16px}
.dash-controls label{font:700 10px/1.2 ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
.dash-controls select{display:block;width:100%;margin-top:6px}
.dash-chart{display:grid;gap:7px;margin:12px 0 18px}
.dash-bar{display:grid;grid-template-columns:minmax(100px,180px) 1fr 62px;align-items:center;gap:10px;font-size:12px}
.dash-bar .track{height:11px;background:var(--grid);border-radius:999px;overflow:hidden;position:relative}
.dash-bar .track i{display:block;height:100%;background:var(--accent);border-radius:inherit}
.dash-bar.bad .track i{background:var(--bad)}
.dash-bar .val{text-align:right;font:750 11px/1 ui-monospace,monospace}
.dash-empty{padding:28px;text-align:center;color:var(--ink-3);border:1px dashed var(--grid);border-radius:8px}
@media(max-width:760px){
  .dash-controls{grid-template-columns:repeat(2,minmax(0,1fr))}
  .playbill .snav button{min-width:112px}
  .dash-bar{grid-template-columns:92px 1fr 52px}
