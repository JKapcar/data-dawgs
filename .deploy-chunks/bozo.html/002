// ---------- DDSync: one-way live mirror (operator writes, everyone else reads) ----------
// Firebase Realtime Database over plain REST — no SDK. Writes are PUT; reads are an
// EventSource stream, so phones get pushes instead of polling. The operator stays
// localStorage-first: a failed push never blocks a sale.
(function(){
  const LS_CFG = "dd-sync-v1";
  // Permanent league DB (created 7/31/26). Baked in so leaguemates need no ?sync= link —
  // the normal Live Draft URL just works. Rules allow read+write on /drafts only.
  const DEFAULT = { url: "https://data-dawgs-draft-default-rtdb.firebaseio.com", room: "pepperoninipples" };
  let cfg = null;

  function readCfg(){
    if(cfg) return cfg;
    let c = null;
    try{
      const q = new URLSearchParams(location.search).get("sync");
      if(q){
        c = JSON.parse(atob(q.replace(/-/g,"+").replace(/_/g,"/")));
        localStorage.setItem(LS_CFG, JSON.stringify(c));   // shared link sticks on this device
      }
    }catch(e){}
    if(!c){ try{ c = JSON.parse(localStorage.getItem(LS_CFG)); }catch(e){} }
    if(!c || !c.url) c = DEFAULT;
    c.url = (c.url||"").replace(/\/+$/,"");
    c.room = (c.room||"pepperoninipples").replace(/[.#$\[\]\/]/g,"-");
    cfg = c; return c;
  }

  let pushTimer = null, lastSent = "";
  window.DDSync = {
    get config(){ return readCfg(); },
    get on(){ return !!readCfg().url },
    save(url, room){
      const c = { url:(url||"").trim().replace(/\/+$/,""), room:(room||"pepperoninipples").trim() };
      try{ localStorage.setItem(LS_CFG, JSON.stringify(c)); }catch(e){}
      cfg = null; return readCfg();
    },
    endpoint(){ const c = readCfg(); return c.url ? `${c.url}/drafts/${c.room}.json` : null; },
    // shareable link for the league: carries the config so phones need no setup
    link(page){
      const c = readCfg();
      if(!c.url) return location.origin + "/" + (page||"board.html?view=live");
      const tok = btoa(JSON.stringify(c)).replace(/\+/g,"-").replace(/\//g,"_");
      const p = page || "board.html?view=live";
      return location.origin + "/" + p + (p.includes("?") ? "&" : "?") + "sync=" + tok;
    },
    // operator → cloud. debounced, best-effort, never throws into the caller
    push(state){
      const ep = this.endpoint(); if(!ep) return;
      clearTimeout(pushTimer);
      pushTimer = setTimeout(()=>{
        let body;
        try{ body = JSON.stringify({ ts: Date.now(), state }); }catch(e){ return; }
        if(body === lastSent) return;
        lastSent = body;
        fetch(ep, { method:"PUT", body, headers:{"Content-Type":"application/json"} })
          .then(()=>window.dispatchEvent(new CustomEvent("ddsync", {detail:{ok:true,dir:"up"}})))
          .catch(()=>window.dispatchEvent(new CustomEvent("ddsync", {detail:{ok:false,dir:"up"}})));
      }, 500);
    },
    // live 