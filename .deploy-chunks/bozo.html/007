    sel.innerHTML = LEAGUES.map(l=>`<option value="${esc(l.id)}"${l.id===LID?' selected':''}>${esc(l.name)}</option>`).join('');
  document.getElementById('lgDemo').style.display = isDemo() ? '' : 'none';
}
document.getElementById('lgPick').onchange = e => {
  // Full reload: the EventSource, the state and every sheet are league-scoped, and a
  // reload re-subscribes cleanly instead of leaving a stream open on the old league.
  const u = new URL(location.href);
  u.searchParams.set('l', e.target.value);
  u.hash = '';
  location.href = u.toString();
};
async function loadLeagues(){
  try{
    const r = await wGet('/league/list');
    LEAGUES = r.leagues || [];
    const want = new URLSearchParams(location.search).get('l');
    LID = (want && LEAGUES.some(l=>l.id===want)) ? want
        : (LEAGUES.some(l=>l.id===r.defaultLeague) ? r.defaultLeague : (LEAGUES[0]||{}).id || 'main');
  }catch(e){
    LEAGUES = []; 
    document.getElementById('srcNote').textContent = 'Leagues unreachable — '+e.message;
  }
}

/* ---------------- sheets: overview / this week / diagnostics / settings ---------------- */
// Hash-routed so every streamlined sheet is linkable. Old #board/#league and player
// sheet links land on their closest new home instead of breaking shared bookmarks.
function view(){
  const h = decodeURIComponent(location.hash.slice(1));
  if(h === 'week' || h === 'this-week') return 'week';
  if(h === 'diagnostics') return 'diagnostics';
  if(h === 'league' || h === 'league-settings') return 'league';
  if(h.startsWith('s=')) return 'diagnostics';
  return 'overview';
}
function goto(v){
  location.hash = v==='overview' ? '' : v==='league' ? 'league-settings' : v;
}
/* Four page-level destinations. Player identity is now a diagnostics filter and the
   entry form lives at the bottom of This Week, so roster-sized navigation is gone. */
let snavActive = null;
function paintSnav(v){
  const el = document.getElementById('snav');
  const btn = (id,label,extra,cls) =>
    `<button data-v="${esc(id)}" class="${cls||''}${v===id?' on':''}"><span class="who">${esc(label)}</span>${extra||''}</button>`;
  el.innerHTML = btn('overview','Overview')
    + btn('week','This Week')
    + btn('diagnostics','Diagnostics')
    + btn('league','League Settings');

  /* ⚠️ Scroll the active cell into view ONLY when the active view actually changed.
     paintSnav runs on every 15s poll and on every hashchange, and an unconditional
     scroll yanks the strip out from under a reader who is mid-drag. Landing on
     #s=Tucholski still has to show you your own cell, or the strip looks like it does
     not contain you.
     ⚠️ Setting scrollLeft on the strip itself, not scrollIntoView: scrollIntoView walks
     every scrollable ancestor including the document, so an off-screen cell would also
     jump the whole page. Only the strip's own scroll should move. */
  if(v !== snavActive){
    snavActive = v;
    const on = el.querySelector('button.on');
    if(on) el.scrollLeft = Math.max(0, on.offsetLeft - (el.clientWidth - on.offsetWidth)/2);
  }
}
document.getElementById('snav').addEventListener('click', e=>{
  const b = e.target.closest('button[data-v]'); if(b) goto(b.dataset.v);
});
document.getElementById('sheetBar').addEventListener('click', e=>{
  const a = e.target.closest('a[data-v]'); if(!a) return;
  e.preventDefault(); goto(a.dataset.v);
});
window.addEventListener('hashchange', ()=>render());

// ⚠️ /bozo/picks and /bozo/results are keyed with encodeURIComponent(name) by the
// Worker, so "The Kid" lives under "The%20Kid". Roster names are decoded. This maps
// a display name onto whichever key the data actually uses. (Pre-existing board bug:
// a player with a space in their name showed "no leg yet" after submitting.)
// ⚠️ THE ONE TRANSLATION POINT. Every board surface works in display names; picks and
// results are keyed by the member's uid. Resolve through the members map first, and only
// then fall back to the encoded name for the legacy/demo leagues that really are
// name-keyed. Reversing that order would make a uid league silently paint an empty board.
const kEnc = p => {
  if (S.picks && S.picks[p]) return p;                      // already a data key
  const ms = (S && S.members) || {};
  for (const k in ms) if (memberLabel(k) === p) return k;
  return encodeURIComponent(p);
};

/* ---------------- the shared betslip link ----------------
   One DraftKings link per league per week, posted by any member.

   ⚠️ THE HOST IS RE-CHECKED HERE, before anything becomes an anchor. The Worker
   validates on write and is the authority, but this node streams straight out of
   RTDB to every reader — so the page never renders a value it has not itself
   checked into a link somebody is going to click. Belt and braces, deliberately:
   the two checks are in different trust domains. */
const DK_SHARE_HOSTS = ['dksb.sng.link','draftkings.onelink.me'];
function dkHostOk(h){
  h = String(h||'').toLowerCase();
  return h==='draftkings.com' || /\.draftkings\.com$/.test(h) || DK_SHARE_HOSTS.indexOf(h)>=0;
}
// Returns a slip only if it still passes, so every caller downstream is safe.
function slipOf(){
  const sl = S.slip;
  if(!sl || typeof sl.url !== 'string') return null;
  let u; try{ u = new URL(sl.url); }catch(e){ return null; }
  if(u.protocol !== 'https:' || !dkHostOk(u.hostname)) return null;
  return {url:u.toString(), host:u.hostname.toLowerCase(), by:sl.by||'', ts:sl.ts||0};
}
let slipEdit = false, slipBusy = false;

function paintSlipBar(){
  const el = document.getElementById('slipBar');
  if(!el) return;
  const sl = slipOf();
  const mine = !!(ME && names().indexOf(ME.name)>=0);
  const graded = (S.status||'open')==='graded';
  const canPost = mine && !graded;

  if(slipEdit && canPost){
    el.innerHTML =
      `<div class="sb-edit">` +
        `<label for="slipUrl">Paste the DraftKings betslip link</label>` +
        `<div class="row">` +
          `<input id="slipUrl" type="url" inputmode="url" autocomplete="off" spellcheck="false" ` +
            `placeholder="https://sportsbook.draftkings.com/..." value="${sl?esc(sl.url):''}">` +
          `<button class="btn" data-slip="save"${slipBusy?' disabled':''}>${slipBusy?'Saving…':'Save'}</button>` +
          `<button class="chip" data-slip="cancel">Cancel</button>` +
        `</div>` +
        `<p class="sb-err" id="slipErr"></p>` +
      `</div>`;
    wireSlipBar();
    return;
  }

  if(sl){
    el.innerHTML =
      `<div class="sb-live">` +
        `<a class="sb-go" href="${esc(sl.url)}" target="_blank" rel="noopener noreferrer">Open the betslip &rarr;</a>` +
        `<span class="sb-meta">${esc(sl.host)}<br>posted by <b>${esc(sl.by||'someone')}</b>` +
          (sl.ts?` &middot; ${esc(when(sl.ts))}`:'') + `</span>` +
        (canPost ? `<span class="sb-acts">` +
          `<button data-slip="add">Replace</button>` +
          `<button data-slip="clear">Remove</button></span>` : '') +
      `</div>`;
    wireSlipBar();
    return;
  }

  if(canPost){
    el.innerHTML =
      `<div class="sb-ask"><span>No betslip link yet &mdash; whoever places it can put it here.</span>` +
        `<button class="btn" data-slip="add">Add the link</button></div>`;
    wireSlipBar();
    return;
  }

  // Nothing to show and nothing you could do about it. Say which of the two.
  el.innerHTML = (sl===null && graded)
    ? `<p class="sb-quiet">No betslip link was posted for this week.</p>`
    : `<p class="sb-quiet">No betslip link yet &mdash; anyone in the league can post one.</p>`;
}

function wireSlipBar(){
  const el = document.getElementById('slipBar');
  if(!el || el.dataset.wired) return;
  el.dataset.wired = '1';
  el.addEventListener('click', ev=>{
    const b = ev.target.closest('[data-slip]');
    if(!b) return;
    ev.preventDefault();
    const act = b.getAttribute('data-slip');
    if(act==='add'){ slipEdit = true; paintSlipBar();
      const i = document.getElementById('slipUrl'); if(i){ i.focus(); i.select(); } return; }
    if(act==='cancel'){ slipEdit = false; paintSlipBar(); return; }
    if(act==='save'){ saveSlip(); return; }
    if(act==='clear'){
      if(!confirm('Take the betslip link down?')) return;
      saveSlip('');
    }
  });
  el.addEventListener('keydown', ev=>{
    if(ev.key==='Enter' && ev.target && ev.target.id==='slipUrl'){ ev.preventDefault(); saveSlip(); }
  });
}

async function saveSlip(force){
  const err = document.getElementById('slipErr');
  const inp = document.getElementById('slipUrl');
  const raw = force!==undefined ? force : (inp ? inp.value.trim() : '');
  const say = m => { if(err) err.textContent = m; else alert(m); };

  // Mirror the Worker's rules so the ordinary mistake is answered instantly and
  // without a round trip. The Worker still decides — this only saves a request.
  if(raw){
    let u;
    try{ u = new URL(raw); }catch(e){ return say('That is not a link.'); }
    if(u.protocol !== 'https:') return say('The link has to be https.');
    if(!dkHostOk(u.hostname))
      return say('Only DraftKings links go on the ticket — that one points at ' + u.hostname.toLowerCase() + '.');
  }
  slipBusy = true; paintSlipBar();
  try{
    await wPost('/league/slip', {url: raw});
    slipEdit = false;
    if(raw) S.slip = {url: raw, host: new URL(raw).hostname.toLowerCase(), by: ME?ME.name:'', ts: Date.now()};
    else S.slip = null;
  }catch(e){
    slipBusy = false; paintSlipBar(); say(e.message); return;
  }
  slipBusy = false; paintSlipBar();
}

function render(){
  const players = names();
  const picks = S.picks || {};
  const status = S.status || 'open';
  // ⚠️ keys via kEnc — picks are stored URL-encoded, roster names aren't
  const live = players.map(p=>({p, ...(picks[kEnc(p)]||{})})).filter(x=>x.price!=null);
  const hub = onHub();
  paintHub();
  document.body.classList.toggle('pb-hub', hub);
  // The band reports one league's week, status and roster — nonsense on a directory of
  // several. The title, eyebrow and dek are the site's, not a league's, and stay.
  document.getElementById('bzBand').style.display = hub ? 'none' : '';
  /* ⚠️ On the hub the BILL is the masthead — it prints the eyebrow, the wordmark and
     the dek itself, at broadside scale. Leaving #bzHead up too rendered "BOZO" twice,
     six inches apart. On a league board the header stays exactly as it was: it is the
     playbill for THAT league and carries the cast strip. */
  document.getElementById('bzHead').style.display = hub ? 'none' : '';
  if(!hub) document.body.classList.remove('pb-hasbar');
  document.getElementById('statusChip').style.display = hub ? 'none' : '';
  document.getElementById('backHub').style.display = (hub || LEAGUES.length<2) ? 'none' : '';
  // On the hub every league-scoped card is hidden; the directory is the whole page.
  for(const id of ['snav','lgbar','sheetBar','royaleAlert','submitCard','ticketCard','seasonCard','sheetCard','leagueCard','drawCard','royaleCard','clvCard','survCard','diagCard','hierHistoryCard','diagExploreCard','gradeCard','verdict'])
    { const el=document.getElementById(id); if(el && hub) el.style.display='none'; }
  if(hub) return;
  document.getElementById('snav').style.display = '';
  document.getElementById('royaleAlert').style.display = view()==='week' ? '' : 'none';

  const v = view();
  const onOverview = v==='overview';
  const onWeek = v==='week';
  const onDiagnostics = v==='diagnostics';
  paintLeagueBar();
  paintSnav(v);

  const c=document.getElementById('statusChip');
  c.className='chip '+status;
  c.textContent='Week '+(S.week||1)+' · '+status;
  /* ⚠️ In Bozo Royale the denominator is who is still ALIVE, not who is in the league.
     "3 of 8 in" when five have been chopped reads as a board still waiting on five
     people who are never coming.

     ⚠️ And it is floored at the number of legs actually on the board. The chop resolves
     when the week is GRADED, so between that moment and the next week opening, the
     roster has already shrunk while the graded week's legs are all still displayed —
     which without this read "2 of 1 in". */
  const expected = isRoyale() ? Math.max(live.length, royaleAliveNames().length) : players.length;
  document.getElementById('fill').textContent = live.length+' of '+expected+' in';

  const open = status==='open';
  const mine = ME ? picks[kEnc(ME.name)] : null;
  const bd = band();
  // Personal entry is the last surface on This Week. A chopped Royale player doesn't
  // get one: they fund the ticket, they don't bet on it.
  const meAlive = !ME || !isRoyale() || (royaleOf(ME.name)?.alive !== false);
  document.getElementById('submitCard').style.display = (ME && open && onWeek && meAlive) ? '' : 'none';
  document.getElementById('submitH').textContent = mine ? 'Your leg — editing resets your clock and price' : 'Your leg';
  document.getElementById('bandNote').textContent =
    `Favorites only, ${bd.ceil} to ${bd.floor} — the minus is already in the box, just type the number. No exact duplicates. Editing resets your clock and your price. The ticket locks the moment the last leg lands.`;
  const cm=document.getElementById('clearMine'); if(cm) cm.style.display = mine ? '' : 'none';

  // Two destinations, one source. The banner is news and sits under the header; the log
  // is a receipt and sits at the bottom of the board.
  paintRoyaleAlert();
  paintRoyaleLog();
  // ⚠️ Repaint the preview on every board change, not just on your own typing. Someone
  // else claiming the selection you are looking at is exactly the moment you need to
  // know, and a preview that only updates when YOU touch something would still be
  // telling you it is available.
  if(document.getElementById('submitCard').style.display !== 'none'){ prefillFromMyLeg(mine); paintLegPreview(); }
  else if(!mine) prefilledFor = null;
  // Overview carries the season-long chart; Diagnostics loads the same ledger for its
  // filters without duplicating a data source.
  if(onOverview || onDiagnostics){ clvLoad();
    if(onOverview) paintSurvival();
    else { document.getElementById('clvCard').style.display='none'; document.getElementById('survCard').style.display='none'; }
  }
  else { document.getElementById('clvCard').style.display='none';
         document.getElementById('survCard').style.display='none'; }

  // the sheets themselves
  document.getElementById('ticketCard').style.display = onWeek ? '' : 'none';
  if(onWeek) paintSlipBar();
  document.getElementById('authCard').style.display = (onWeek && !ME) ? '' : 'none';
  document.getElementById('seasonCard').style.display = onOverview ? '' : 'none';
  document.getElementById('sheetCard').style.display = 'none';
  document.getElementById('sheetBar').style.display = 'none';
  document.getElementById('leagueCard').style.display = v==='league' ? '' : 'none';
  if(v==='league'){ paintLeague();
    // Manager-only, and it reaches every week rather than just this one.
    if(canManage(league()||{})) paintGaps();
    else { const b=document.getElementById('gapBody'); if(b) b.innerHTML=''; }
  }

  paintSlip(players, picks, status, live);

  document.getElementById('placeNote').textContent = open
    ? `Locks when every leg is in — ${Math.max(0, expected-live.length)} to go. That moment is the close for the ticket, and the server draws the hierarchy on the spot.`
    : 'Placed. Entry prices frozen.';
  /* ⚠️ THIS SENTENCE CHANGED WHEN THE CAPTURE SHIPPED, and only half of it changed.
     Closing prices are now snapped at kickoff from DraftKings via a licensed
     aggregator — those ARE checked. The ENTRY price is still a number a human typed and
     nothing verifies it, so a player who mis-enters a better price than they got shows
     inflated CLV. Saying "prices are checked now" would be the easy lie. */
  document.getElementById('placeNote').textContent +=
    ' Closing prices are captured at kickoff from DraftKings; entry prices are still typed in by each player and'
    + ' are not checked against the book, so any CLV here mixes one verified number with one unverified one.';

  // hierarchy — the machine is on the board at ALL times now. Before the draw it
  // idles (armed); the reels STOP only when the server has actually drawn, so a
  // stopped reel always means a real, written-once result.
  const ord = S.order;
  document.getElementById('drawCard').style.display = onWeek ? '' : 'none';
  if(onWeek) paintMachine(ord);

  // Overview gets the current-week diagnostic snapshot; the Diagnostics sheet gets
  // the filterable season ledger below.
  if(onOverview) paintDiag(live, players, status);
  else document.getElementById('diagCard').style.display='none';
  document.getElementById('hierHistoryCard').style.display = onOverview ? '' : 'none';
  if(onOverview) paintHierarchyHistory();
  document.getElementById('diagExploreCard').style.display = onDiagnostics ? '' : 'none';
  if(onDiagnostics && CLV.data && CLV.lid===LID) paintDiagnosticsExplorer();
  else if(onDiagnostics){
    document.getElementById('dxMeta').textContent='loading ledger…';
    document.getElementById('dxTiles').innerHTML='';
    document.getElementById('dxChart').innerHTML='<div class="dash-empty">Loading the season ledger…</div>';
    document.querySelector('#dxTable tbody').innerHTML='';
    document.getElementById('dxNote').textContent='';
  }

  // grading — the Worker is the authority; this only decides what to show
  document.getElementById('gradeCard').style.display = (isManager() && status==='placed' && onWeek) ? '' : 'none';
  if(isManager() && status==='placed' && onWeek) paintManual(live);
  const ar=document.getElementById('adminRow');
  if(ar) ar.style.display = (isManager() && status==='graded') ? '' : 'none';

  document.getElementById('verdict').style.display = (S.bozo && onWeek) ? '' : 'none';
  if(S.bozo){
    document.getElementById('vName').textContent = teamOf(playerName(S.bozo));
    document.getElementById('vWhy').textContent = S.bozoWhy||'';
  }

  // season table
  const t={}; players.forEach(p=>t[p]=0);
  (S.history||[]).forEach(h=>{ const b=h&&h.bozo&&playerName(h.bozo); if(b && t[b]!=null) t[b]++; });
  const bzNow = S.bozo && playerName(S.bozo);
  if(bzNow && t[bzNow]!=null) t[bzNow]++;
  const mx=Math.max(0,...Object.values(t));
  /* ⚠️ WHO HOLDS THE BELT IS NOT WHO HAS WORN IT MOST. The `.fund` plaque marks the
     season's highest bozo count; the belt is a single object and it sits with the MOST
     RECENT bozo until someone takes it off them. Before this week is graded that is last
     week's, which is exactly the point — you keep it until you don't.
     (The plaque reads "funds this week" while being computed from the max count. That
     mismatch predates this and is left alone rather than quietly redefined.) */
  paintTicker(players, t, mx, beltHolder());

  // Flex order makes the requested hierarchy explicit without duplicating any card.
  const order = (id,n)=>{ const el=document.getElementById(id); if(el) el.style.order=String(n); };
  order('seasonCard',2); order('clvCard',3); order('diagCard',4);
  order('hierHistoryCard',5); order('survCard',6); order('royaleCard',7);
  order('drawCard',2); order('ticketCard',3); order('royaleAlert',4); order('verdict',5);
  order('gradeCard',6); order('authCard',7); order('submitCard',8);
  order('diagExploreCard',2); order('leagueCard',2);
}

/* ---------------- player sheet ---------------- */
// Everything here derives from /bozo/ledger at read time — imp/CLV are computed
// from the stored raw prices, never persisted (the SD table will be retuned and
// stored derivatives would rot). The ledger starts writing the moment a week locks.
const resOf = r => r.result || (r.won===true?'won':r.won===false?'lost':null);
function sheetRows(player){
  return Object.values(S.ledger||{}).filter(r=>r && r.player===player)
    .sort((a,b)=>(b.season-a.season)||(b.week-a.week));
}
function paintSheet(player){
  const rows = sheetRows(player);
  const isMe = ME && ME.name===player;
  document.getElementById('shName').textContent = teamOf(player) + (isMe?' — your sheet':'');
  document.getElementById('shMeta').textContent =
    (player===ADMIN?'league manager · ':'') +
    ((ROSTER.find(p=>p.name===player)||{}).claimed ? 'claimed' : 'not claimed yet');

  const w  = rows.filter(r=>resOf(r)==='won').length;
  const l  = rows.filter(r=>resOf(r)==='lost').length;
  const pv = rows.filter(r=>['push','void'].includes(resOf(r))).length;
  const bozos = (S.history||[]).filter(h=>h && playerName(h.bozo)===player).length
    + (S.bozo && playerName(S.bozo)===player ? 1 : 0);
  const priced = rows.filter(r=>Number.isFinite(r.price));
  const avgPx = priced.length ? Math.round(priced.reduce((a,r)=>a+r.price,0)/priced.length) : null;
  const chalk = rows.filter(r=>r.shortestOdds).length;
  const lastIn = names().length ? rows.filter(r=>r.rank===names().length).length : 0;
  /* ⚠️ De-vigged, matching the CLV chart. This used to be raw implied on both ends,
     which gave a second, different CLV number for the same player on the same page.
     Raw-minus-raw partly cancels the hold, but only when both sides carry the same one —
     they don't, and the residual is the same order of magnitude as the whole spread of
     CLV across the league. A leg missing either side of either price is excluded rather
     than de-vigged against nothing, so this counts only what the chart counts. */
  const withClose = rows.filter(r=>devigP(r.close, r.closeOpp)!=null && devigP(r.price, r.priceOpp)!=null);
  const clv = withClose.length
    ? withClose.reduce((a,r)=>a+(devigP(r.close,r.closeOpp)-devigP(r.price,r.priceOpp)),0)/withClose.length : null;

  /* The header's sheet bar. Same numbers as the tiles below, computed once, right here —
     it is a locator ("you are on Kap's sheet"), not a second scoreboard, so it gets the
     name, the legs and the CLV and nothing else. Nothing here is invented: a player with
     no capturable closes shows an em dash, the same as the tile. */
  document.getElementById('sheetBar').innerHTML =
    `<b>${esc(teamOf(player))}${isMe?"'s sheet — yours":"'s sheet"}</b>`
    + `<span>${rows.length} leg${rows.length===1?'':'s'}</span>`
    + `<span>${clv==null?'— CLV':((clv>0?'+':'')+(clv*100).toFixed(1)+'pp CLV')}</span>`
    + `<a href="#" data-v="board">← Board</a>`;

  const tile=(lil,big)=>`<div><div class="lil">${lil}</div><div class="big">${big}</div></div>`;
  document.getElementById('shStats').innerHTML =
    tile('Record', `${w}–${l}${pv?'–'+pv:''}`) +
    tile('Bozos', bozos) +
    tile('Legs', rows.length) +
    tile('Avg price', avgPx==null?'—':avgPx) +
    tile('Chalkiest in pool', chalk+'×') +
    tile('Last in', lastIn+'×') +
    tile('Avg CLV', clv==null?'—':((clv>0?'+':'')+(clv*100).toFixed(1)+'pp'));

  // this week
  const x = (S.picks||{})[kEnc(player)];
  const open = (S.status||'open')==='open';
  document.getElementById('shWeek').innerHTML = x && x.price!=null
    ? `<div class="lil" style="margin-bottom:4px">This week</div>
       <span class="who">${esc(x.label)}</span> <span class="px">${x.price}</span>
       <span class="tm">· ${SPORTS[x.sport]?SPORTS[x.sport].n:esc(x.sport)} · ${esc(x.game)} · in ${when(x.ts)}</span>`
    : `<div class="lil" style="margin-bottom:4px">This week</div><span class="pend">${
        open ? (isMe ? 'No leg in yet — the form above is yours.' : 'No leg in yet.') : 'Sat this one out.'}</span>`;

  // full history
  document.querySelector('#shHist tbody').innerHTML = rows.length
    ? '<tr><th>Wk</th><th>Leg</th><th>Price</th><th>Result</th><th>Actual</th><th>Close</th></tr>' +
      rows.map(r=>{
        const res = resOf(r);
        const tag = res==='won' ? '<span class="tag w">W</span>'
                  : res==='lost' ? '<span class="tag l">L</span>'
                  : res ? `<span class="tag p">${esc(res)}</span>` : '<span class="pend">open</span>';
        return `<tr${r.bozo?' class="bz-loser"':''}><td class="tm">${r.season}·w${r.week}</td>
          <td class="pk">${esc(r.label)}${r.bozo?' <span class="tag l">BOZO</span>':''}
            <br><span class="tm">${SPORTS[r.sport]?SPORTS[r.sport].n:esc(r.sport)} · ${esc(r.game)}${r.shortestOdds?' · chalkiest':''}${r.rank?' · #'+r.rank+' in':''}</span></td>
          <td class="px">${r.price}</td><td>${tag}</td>
          <td class="px">${r.actual??'—'}</td><td class="px">${r.close??'—'}${flagBadge(reviewFlag(r))}</td></tr>`;
      }).join('')
    : '';
  document.getElementById('shNote').textContent = rows.length
