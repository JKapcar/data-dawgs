  .boss{bottom:6px;left:40px;width:40px;height:32px;margin-left:-20px;border-radius:6px}
  .track{display:none}
  .arm{left:40px;bottom:15px;margin-left:0;width:152px;height:15px;transform-origin:0 50%;
    transform:rotate(calc(var(--pull,0)*34deg)) scaleX(calc(1 - var(--pull,0)*.13))}
  .rod{border-radius:7px}
  .knob{left:auto;right:-10px;top:50%;width:40px;height:40px;margin:-20px 0 0 0}
  .lever{inset:0}
  .pulllab{bottom:4px;left:auto;right:10px;width:auto;text-align:right}
  .card.bz-carnival{padding-top:46px}
  h2.bz{font-size:12.5px;letter-spacing:1.4px;padding:6px 11px}
}
  /* the tent scales down but keeps its peak — the fan is the whole point of it */
  .card.bz-carnival{padding-top:44px}
  .card.bz-carnival::before{height:34px;
    -webkit-mask:linear-gradient(#000 0 0) 0 0/100% 22px no-repeat,
            radial-gradient(circle at 11px 100%,transparent 0 10px,#000 10.6px) 0 100%/22px 13px repeat-x;
            mask:linear-gradient(#000 0 0) 0 0/100% 22px no-repeat,
            radial-gradient(circle at 11px 100%,transparent 0 10px,#000 10.6px) 0 100%/22px 13px repeat-x}
  .card.bz-carnival > .bz-hdr h2.bz{font-size:12.5px;letter-spacing:1.4px;padding:6px 11px}
  table.bz td,table.bz th{padding-left:5px;padding-right:5px}
  /* ---- diagnostics on a phone: ONE table, scrolled sideways ----
     ⚠️ IT STAYS A TABLE. This was cards for one release and that was the wrong read of
     "hard to tell which column is which" — the complaint was that the columns were
     illegible, not that columns were the wrong shape. Comparing two people on one lever
     is the job, and a column does that for free while a stack of cards makes you hold
     one card in your head and scroll to the next.
     ⚠️ What actually made it unreadable was losing your place while scrolling right, so
     the name column is PINNED to the left edge and rides along. That is the fix: a value
     is never on screen without the name it belongs to.
     ⚠️ The header is NOT sticky, deliberately. .tscroll sets overflow-x, which makes
     overflow-y compute to auto — so a `position:sticky; top:0` there anchors to a
     container that never scrolls vertically and simply does nothing. It would be a rule
     that looks like it works and doesn't. The column rules below do that job instead. */
  #dgTable{min-width:640px}
  /* the name column rides along — without it you scroll to Worst CLV and no longer know
     whose row you are on, which is the whole failure this replaces */
  #dgTable td.who,#dgTable th:first-child{position:sticky;left:0;z-index:2;
    background:var(--surface-1);box-shadow:1px 0 0 var(--grid)}
  #dgTable tr.me td.who{background:color-mix(in srgb,var(--accent) 12%,var(--surface-1))}
  #dgTable td,#dgTable th{white-space:nowrap}
  /* a rule between every column: at this width the eye needs the edge, not just the gap */
  #dgTable td+td,#dgTable th+th{border-left:1px solid var(--grid)}
  .tscroll{position:relative}
  .mcell{min-width:54px}
  .slip-ft{gap:16px;padding-right:96px}
  .stamp{font-size:12px;top:auto;right:10px;bottom:14px;padding:5px 8px;letter-spacing:2px}
  .leg{grid-template-columns:24px minmax(0,1fr) auto;padding:10px 12px}
  .leg::before{left:26px}
  .trow,.thead{grid-template-columns:22px minmax(0,1fr) auto;gap:8px}
  .trow .nm2{font-size:13px;letter-spacing:1.1px}
  .bz-hdr h1{font-size:24px}
}
