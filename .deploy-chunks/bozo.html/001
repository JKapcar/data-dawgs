ion:opacity .35s}
@keyframes bulbchase{to{background-position:17px 0,-17px 100%,0 17px,100% -17px}}
.machine.armed  {--bulbo:.72;--bulbspeed:1.15s;--bulbrun:running}
.machine.pending{--bulbo:1;  --bulbspeed:.42s; --bulbrun:running}
.machine.spin1  {--bulbo:1;  --bulbspeed:.30s; --bulbrun:running}
.machine.spin2  {--bulbo:1;  --bulbspeed:.20s; --bulbrun:running}
.machine.spin3  {--bulbo:1;  --bulbspeed:.13s; --bulbrun:running}
.machine.locked {--bulbo:.92;--bulbspeed:1.6s; --bulbrun:running}

@keyframes cabinetthunk{0%,100%{transform:none}
  16%{transform:translateY(7px) rotate(.3deg)}38%{transform:translateY(-5px) rotate(-.24deg)}
  58%{transform:translateY(3px) rotate(.12deg)}78%{transform:translateY(-1px)}}
.machine.pulling{animation:cabinetthunk .8s cubic-bezier(.2,.8,.2,1)}
@keyframes reelthunk{0%,100%{transform:none}30%{transform:translateY(2.5px)}62%{transform:translateY(-1px)}}
.machine.thunk{animation:reelthunk .16s ease-out}

/* jackpot wash on the final lock */
.machine .flash{position:absolute;inset:0;border-radius:12px;pointer-events:none;z-index:5;opacity:0;
  background:radial-gradient(120% 100% at 50% 40%,rgba(255,224,138,.85),rgba(255,150,50,.28) 45%,transparent 72%)}
@keyframes jackpotflash{0%{opacity:0}12%{opacity:1}100%{opacity:0}}
.machine.jackpot .flash{animation:jackpotflash 1.1s ease-out}

/* ===================== marquee ===================== */
.marq{position:absolute;left:22px;right:104px;top:22px;height:22px;z-index:3;pointer-events:none;
  display:flex;align-items:center;justify-content:center;border-radius:6px;
  background:linear-gradient(180deg,var(--grape),var(--grape-lo));
  box-shadow:inset 0 0 14px rgba(0,0,0,.6),0 1px 0 rgba(255,255,255,.06)}
.marq b{font:800 9.5px/1 ui-monospace,monospace;letter-spacing:5px;color:var(--bulb-off);
  transition:color .3s,text-shadow .3s;white-space:nowrap;overflow:hidden;text-overflow:clip}
.machine.pending .marq b,.machine.locked .marq b{color:var(--bulb);text-shadow:0 0 12px rgba(255,224,138,.8)}

/* ===================== reels ===================== */
.reels{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;position:relative;z-index:2}
.pos{font:700 9.5px/1 ui-monospace,monospace;letter-spacing:1.4px;color:#b7a488;text-transform:uppercase;
  margin:0 0 6px;text-align:center;transition:color .25s,text-shadow .25s}
.reel.lock .pos{color:var(--bulb);text-shadow:0 0 9px rgba(255,224,138,.55)}

.win{position:relative;height:104px;overflow:hidden;border-radius:8px;
  background:linear-gradient(180deg,#fffdf7,#efe6d4);
  border:2px solid var(--brass-lo);
  box-shadow:inset 0 0 14px rgba(43,28,14,.18);
  transition:border-color .2s,box-shadow .25s}
/* curved glass + payline. Both are ::pseudo so a reel is one element. */
.win::before{content:"";position:absolute;inset:0;z-index:3;pointer-events:none;
  background:linear-gradient(180deg,rgba(255,255,255,.62),rgba(255,255,255,0) 34%,
             rgba(43,28,14,.05) 60%,rgba(43,28,14,.20))}
.win::after{content:"";position:absolute;left:6px;right:6px;top:50%;height:2px;margin-top:-1px;z-index:3;
  pointer-events:none;background:linear-gradient(90deg,transparent,var(--nose),transparent);
  opacity:.3;transition:opacity .25s}
.reel.lock .win{border-color:var(--brass-hi);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 34%,transparent),0 0 24px rgba(255,201,116,.42),
             inset 0 0 20px rgba(255,180,80,.22)}
.reel.lock .win::after{opacity:.65}
/* 1st decides most weeks, so it gets the jackpot frame — :first-child, so it
   follows the reel set rather than a hardcoded index. */
.reels > .reel:first-child.lock .win{
  box-shadow:0 0 0 3px var(--accent),0 0 30px color-mix(in srgb,var(--accent) 58%,transparent),
             inset 0 0 22px rgba(255,150,50,.3)}

.strip{position:absolute;left:0;right:0;top:0;will-change:transform;
  transform:translate3d(0,0,0);filter:blur(0px)}
.cell{height:104px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;
  text-align:center;padding:0 5px;color:#2b1c0e;border-bottom:1px solid rgba(43,28,14,.12)}
.cell svg{width:26px;height:26px;flex:0 0 26px;opacity:.88}
.cell span{font:800 11.5px/1.15 system-ui;letter-spacing:.4px;text-transform:uppercase}
/* the strip blurs with velocity — set from JS as a px value */
.reel.moving .strip{filter:blur(var(--mblur,2px))}
/* a reel that has just stopped gets a one-frame gold pop on the payline */
@keyframes cellpop{0%{transform:scale(1)}40%{transform:scale(1.09)}100%{transform:scale(1)}}
.reel.pop .cell{animation:cellpop .28s ease-out}

/* ===================== the lever ===================== */
.leverbay{position:absolute;right:0;top:0;bottom:0;width:104px;z-index:3}
/* brass boss the arm pivots on */
/* mounting plate the arm pivots on — a plate, not a second ball */
.boss{position:absolute;bottom:32px;left:26px;width:44px;height:30px;margin-left:-22px;border-radius:6px 6px 4px 4px;
  background:linear-gradient(180deg,var(--brass),#5c4718);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 -4px 8px rgba(0,0,0,.5),0 2px 6px rgba(0,0,0,.5);z-index:1}
.boss::after{content:"";position:absolute;left:50%;top:6px;width:16px;height:16px;margin-left:-8px;border-radius:50%;
  background:radial-gradient(circle at 34% 30%,#e8cf9a,#8a6a2c 60%,#3a2a12);
  box-shadow:inset 0 -2px 4px rgba(0,0,0,.55)}
/* the arc track: shows where the knob goes before you touch it */

.lever{position:absolute;left:0;right:2px;bottom:16px;top:16px;background:none;border:0;padding:0;margin:0;
  color:inherit;font:inherit;cursor:default;touch-action:none;-webkit-tap-highlight-color:transparent;
  display:block}
.lever:focus-visible{outline:2px solid var(--bulb);outline-offset:-6px;border-radius:10px}
.lever.live{cursor:grab}
.lever.live:active{cursor:grabbing}
.arm{position:absolute;left:26px;bottom:46px;width:13px;height:96px;margin-left:-6.5px;
  transform-origin:50% 100%;
  transform:rotate(calc(var(--pull,0)*34deg)) scaleY(calc(1 - var(--pull,0)*.12));
  transition:transform var(--armT,.5s) cubic-bezier(.18,.86,.28,1.06)}
.rod{position:absolute;inset:0;border-radius:7px;
  background:linear-gradient(90deg,#40311a,#a8873c 24%,var(--brass-hi) 47%,#a8873c 70%,#40311a);
  box-shadow:0 0 0 1px rgba(0,0,0,.45),inset 0 0 8px rgba(0,0,0,.25)}
.knob{position:absolute;left:50%;top:-13px;width:50px;height:50px;margin-left:-25px;border-radius:50%;
  background:radial-gradient(circle at 34% 28%,#ff9a86 0 10%,var(--nose) 48%,#8a1a0c 100%);
  box-shadow:inset 0 -6px 11px rgba(0,0,0,.42),0 0 0 3px #3a2a12,0 6px 14px rgba(0,0,0,.5);
  transform:scale(calc(1 - var(--pull,0)*.09))}
/* "beg" pulse only when a draw is sitting on the server waiting for this reader */
@keyframes knobbeg{
  0%,100%{box-shadow:inset 0 -6px 11px rgba(0,0,0,.42),0 0 0 3px #3a2a12,0 0 0 0 rgba(227,59,38,.55)}
  50%    {box-shadow:inset 0 -6px 11px rgba(0,0,0,.42),0 0 0 3px #3a2a12,0 0 0 15px rgba(227,59,38,0)}}
.machine.pending .lever:not(.dragging) .knob{animation:knobbeg 1.2s ease-in-out infinite}
/* centred on the boss (26px in), and NARROW ENOUGH TO STAY IN THE BAY — at
   78px it hung 13px past the bay's left edge and sat over the 4th reel's
   column. If the decal text ever gets longer again, shorten the text. */
.pulllab{position:absolute;left:0;width:52px;bottom:17px;text-align:center;white-space:nowrap;
  font:800 10px/1 ui-monospace,monospace;letter-spacing:1.8px;text-transform:uppercase;
  color:var(--bulb-off);transition:color .3s;pointer-events:none}
.lever.live ~ .pulllab{color:var(--bulb);text-shadow:0 0 9px rgba(255,201,116,.6)}
/* the commit threshold, drawn on the track so "how far is far enough" is visible */
.detent{position:absolute;left:50%;bottom:59px;width:6px;height:6px;margin-left:-3px;border-radius:50%;
  background:var(--bulb);opacity:0;transform-origin:50% 50%;
  translate:0 0;pointer-events:none;transition:opacity .25s}
.lever.dragging ~ .detent{opacity:.85}

/* ===================== coins ===================== */
.coins{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:6;border-radius:12px}
.coin{position:absolute;width:14px;height:14px;border-radius:50%;
  background:radial-gradient(circle at 32% 28%,var(--bulb),var(--gold) 52%,#8a6412);
  box-shadow:0 0 8px rgba(255,201,116,.7),inset 0 -2px 3px rgba(0,0,0,.35)}

.ord{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:6px}
.ord li{display:flex;gap:10px;align-items:baseline;opacity:0;transform:translateY(4px);
  transition:opacity .3s,transform .3s;font-size:14px}
.ord li.on{opacity:1;transform:none}
.ord .n{font:800 11px ui-monospace,monospace;color:var(--accent);flex:0 0 16px}
.ord li:first-child b{color:var(--accent)}.ord .d{color:var(--ink-3);font-size:13px}
/* ================= the belt =================
   Roger Goodell's Super Bowl / Super Browns / Fake Hair — the physical trophy the
   league actually passes around, cropped to its centre plate.

   ⚠️ INLINE, not a file in assets/. Every page in this repo is self-contained and
   sw.js caches by a hash of the HTML, so an external image would sit outside that
   hash and could go stale on its own — a new belt with the old page, or the reverse.
   8 KB of base64 against a 250 KB page is the cheaper problem.

   ⚠️ Declared ONCE. The season crest and the verdict trophy are the same bytes at two
   sizes; two copies of a data URI in one file is 8 KB of duplication that will
   eventually disagree with itself. */
:root{--belt:url('data:image/jpeg;base64,')}
/* The crest, beside whoever is holding it. Rounded rather than circular — the plate is
   square and a hard circle crops the lettering off all four sides. */
.who2 .beltcrest{width:17px;height:17px;flex:0 0 17px;margin-left:5px;vertical-align:-4px}
.beltcrest{display:inline-block;width:22px;height:22px;flex:0 0 22px;border-radius:5px;
  background:var(--belt) center/cover;vertical-align:-5px;margin-left:7px;
  box-shadow:0 0 0 1.5px var(--gold,#f0b429),0 1px 4px rgba(0,0,0,.5)}
.verdict .belttrophy{width:76px;height:76px;margin:0 auto 10px;border-radius:12px;
  background:var(--belt) center/cover;
  box-shadow:0 0 0 2px #c9a24a,0 0 22px rgba(255,201,116,.28),0 6px 16px rgba(0,0,0,.5)}
.verdict{background:#241c12;color:#ecdfc9;border-radius:12px;padding:22px;margin-bottom:16px;text-align:center}
.verdict .nm{font:800 34px/1 system-ui;color:#fff;letter-spacing:-.8px;margin:6px 0}
.verdict .why{color:#b7a488;font-size:14px}
/* ---- the ticket, as a printed parlay slip ---- */
.slip{position:relative;background:var(--page);border:1px solid var(--grid);border-radius:4px;
  padding:8px 0 0;margin:4px 0 0;font-family:ui-monospace,Menlo,monospace;overflow:hidden}
/* perforated top/bottom: half-circles punched in the CARD colour, so the slip
   reads as torn off a roll. Uses --surface-1 because the card is what's behind it. */
.slip::before,.slip::after{content:"";position:absolute;left:0;right:0;height:8px;pointer-events:none;
  background:radial-gradient(circle at 6px 0,var(--surface-1) 0 5px,transparent 5.5px) 0 0/12px 8px repeat-x}
.slip::before{top:0}
.slip::after{bottom:0;transform:rotate(180deg)}
.slip-hd{display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;
  padding:10px 16px 10px;border-bottom:2px solid var(--ink-1);margin:0 0 2px}
.slip-hd .t{font:800 12.5px/1 ui-monospace,monospace;letter-spacing:2.2px;text-transform:uppercase;color:var(--ink-1)}
.slip-hd .s{font:700 10.5px/1 ui-monospace,monospace;letter-spacing:1.4px;text-transform:uppercase;color:var(--ink-3)}
.legs{list-style:none;margin:0;padding:0}
.leg{position:relative;display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:0 12px;
  padding:11px 16px;border-bottom:1px dashed var(--grid);align-items:start}
.leg:last-child{border-bottom:0}
/* the parlay rail — one line chaining every leg together, which is the whole
   visual point of a parlay vs. eight singles */
.leg::before{content:"";position:absolute;left:28px;top:0;bottom:0;width:1px;background:var(--grid)}
.leg:first-child::before{top:22px}
.leg:last-child::before{bottom:calc(100% - 22px)}
.mk{position:relative;z-index:1;width:21px;height:21px;border-radius:50%;margin-top:1px;
  display:flex;align-items:center;justify-content:center;background:var(--page);
  border:2px solid var(--ink-3);color:var(--ink-2);font:800 10px/1 ui-monospace,monospace}
.leg.on .mk{border-color:var(--accent);color:var(--accent)}
.leg.won .mk{background:var(--good);border-color:var(--good);color:#fff}
.leg.lost .mk{background:var(--bad);border-color:var(--bad);color:#fff}
.leg.void .mk{background:var(--ink-3);border-color:var(--ink-3);color:#fff}
.leg.empty .mk{border-style:dashed;opacity:.6}
.leg .who2{font:800 12px/1.35 ui-monospace,monospace;letter-spacing:1.3px;text-transform:uppercase;color:var(--ink-1)}
.leg .sel{font-family:system-ui,-apple-system,sans-serif;font-weight:650;font-size:14.5px;
  color:var(--ink-1);margin-top:2px;overflow-wrap:anywhere}
.leg .mkt{font:11px/1.5 ui-monospace,monospace;color:var(--ink-3);margin-top:2px;overflow-wrap:anywhere}
.leg.empty .sel{color:var(--ink-3);font-style:italic;font-weight:500}
.leg.bz{background:color-mix(in srgb,var(--bad) 10%,transparent)}
.leg.mine{box-shadow:inset 3px 0 0 var(--accent)}
.leg .rt{text-align:right;white-space:nowrap}
.leg .pxv{font:800 15px/1.2 ui-monospace,monospace;color:var(--ink-1);font-variant-numeric:tabular-nums}
.leg.empty .pxv{color:var(--ink-3);font-weight:600;font-size:12px}
.leg .tin{font:10.5px/1.6 ui-monospace,monospace;color:var(--ink-3)}
.slip-ft{display:flex;gap:24px;flex-wrap:wrap;align-items:baseline;
  border-top:2px solid var(--ink-1);margin:2px 0 0;padding:14px 112px 20px 16px}
/* Anchored to the FOOTER, not the first leg — at top:44px it landed squarely on
   leg one's price in every theme and width. The footer reserves 112px of right
   padding so the stamp can never sit on a number. */
.stamp{position:absolute;right:14px;bottom:16px;transform:rotate(-11deg);pointer-events:none;
  font:800 15px/1 ui-monospace,monospace;letter-spacing:3px;text-transform:uppercase;
  padding:6px 10px;border:2.5px solid currentColor;border-radius:5px;opacity:.5}
.stamp.open{color:var(--accent)}.stamp.placed{color:var(--warn)}.stamp.graded{color:var(--good)}
/* ---- diagnostics ---- */
.meter{display:block;width:100%;min-width:56px;height:8px;border-radius:4px;overflow:hidden;
  background:color-mix(in srgb,var(--accent) 15%,transparent)}
.meter i{display:block;height:100%;border-radius:4px;background:var(--accent)}
.meter.risk{background:color-mix(in srgb,var(--bad) 15%,transparent)}
.meter.risk i{background:var(--bad)}
.mcell{display:flex;flex-direction:column;gap:4px;min-width:74px}
.mcell .v{font:700 12.5px/1 ui-monospace,monospace;color:var(--ink-1);font-variant-numeric:tabular-nums}
.tbd{font:700 10px/1 ui-monospace,monospace;letter-spacing:1px;color:var(--ink-3);
  border:1px dashed var(--grid);border-radius:4px;padding:3px 5px;display:inline-block}
.flag{display:flex;gap:9px;align-items:flex-start;font-size:13.5px;color:var(--ink-2);
  border-left:3px solid var(--warn);padding:8px 0 8px 11px;margin:12px 0 0}
.flag b{color:var(--ink-1)}
.flag.corr{border-left-color:var(--bad)}
.tscroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
/* ---- season, as a split-flap board ---- */
/* Dark plate in BOTH themes on purpose — same call as .machine and .verdict.
   A chalkboard was considered and rejected: green + handwriting fights the
   mono/terminal identity the rest of this page is built on. */
.tboard{background:#191209;border:1px solid #2b2318;border-top:3px solid var(--accent);
  border-radius:11px;padding:12px 10px 8px;box-shadow:inset 0 14px 26px rgba(0,0,0,.5)}
.thead,.trow{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:12px;align-items:center;padding:7px 8px}
.thead{border-bottom:1px solid #2f2619;padding-bottom:9px;margin-bottom:2px}
.thead span{font:700 9.5px/1 ui-monospace,monospace;letter-spacing:1.6px;text-transform:uppercase;color:#7a6a52}
.thead span:last-child{text-align:right}
.trow{border-bottom:1px solid #241d15}
.trow:last-child{border-bottom:0}
.trow .rk{font:800 12px/1 ui-monospace,monospace;color:#7a6a52;font-variant-numeric:tabular-nums}
.trow .nm2{font:800 15px/1.2 ui-monospace,monospace;letter-spacing:1.7px;text-transform:uppercase;
  color:#ecdfc9;display:flex;align-items:center;gap:9px;flex-wrap:wrap;min-width:0}
.trow.me2 .nm2{color:#ff9146}
.fund{font:700 9px/1 ui-monospace,monospace;letter-spacing:1.2px;text-transform:uppercase;
  color:#1a1206;background:var(--accent);padding:4px 7px;border-radius:4px;white-space:nowrap}
.flap{display:flex;gap:3px;perspective:280px}
.flap b{position:relative;min-width:21px;height:30px;border-radius:3px;background:#241d15;color:#ffcf9a;
  font:800 18px/30px ui-monospace,monospace;text-align:center;padding:0 2px;
  box-shadow:inset 0 -2px 0 rgba(0,0,0,.5),0 1px 0 rgba(255,255,255,.04)}
.flap b::after{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(0,0,0,.55)}
.flap b.zero{color:#93805f}
@keyframes flap{0%{transform:rotateX(-90deg);filter:brightness(1.8)}100%{transform:none}}
.flap b.flip{animation:flap .45s cubic-bezier(.2,.9,.3,1);transform-origin:50% 0}
/* ---- machine: armed (pre-draw) idle state ---- */
.machine.armed .win{border-color:rgba(255,255,255,.09)}
/* idle motion is owned by the v2 rAF engine, not CSS — see the BOZO MACHINE v2
   block above. A CSS animation on `transform` would override it. */
.machine.armed .cell{opacity:.62}
.ord li.ghost{opacity:1}
.ord li.ghost b{color:var(--ink-3);font-weight:650}
.ord li.ghost .n{color:var(--ink-3)}

/* ================= carnival-casino skin =================
   Applies to exactly three surfaces: the hierarchy machine (#drawCard), the
   diagnostics plate (#diagCard) and the season board (#seasonCard).

   ⚠️ This is PAINT ONLY. No class the JS reads is renamed and no layout box is
   restructured — the reveal logic below is the only behavioural change on this
   page. If you need to undo the look, delete this block and the three
   `bz-carnival` classes in the markup; everything still works.

   ⚠️ These three plates are dark in BOTH themes, which is the call .machine,
   .verdict and .tboard already made before this skin existed. A felt/brass
   surface that flips to cream in light theme stops reading as a machine, and
   the reel windows have to stay cream either way for the type to survive.
   So all inks inside a plate are declared literally here rather than inherited
   from --ink-*, which in light theme are dark-on-dark. */
.bz-carnival{
  /* the cabinet's own metals — brown-and-gold, unchanged */
  --brass:#c9a24a; --brass-hi:#f2dda6; --brass-lo:#6d5220;
  --nose:#e33b26; --cream:#fff8ea;
  /* the midway palette: tent red, gold, grape signs, turquoise booth */
  --candy:#e03131; --gold:#f0b429; --gold-hi:#ffe9a8; --gold-lo:#8a6212;
  --grape:#2c1a52; --grape-lo:#1a0f33;
  --teal:#0f7a75; --teal-hi:#13908a; --teal-lo:#06423e;
}
/* --- the big top: stripes FAN from a peak, with a scalloped valance and a pennant.
   ⚠️ A plain diagonal stripe band was tried first and reads as a decorative header,
   not a tent — the fan and the peak are what make it a big top. The `at 50% 165%`
   focus puts the vanishing point below the card so the fan spreads across the full
   width instead of pinching in the middle. --- */
.card.bz-carnival{position:relative;overflow:hidden;padding-top:52px;border-color:var(--gold-lo)}
.card.bz-carnival::before{
  content:"";position:absolute;left:0;right:0;top:0;height:42px;pointer-events:none;
  background:repeating-conic-gradient(from -92deg at 50% 165%,
    var(--candy) 0 2.6deg, var(--cream) 2.6deg 5.2deg);
  /* two mask layers: a solid band on top, scallops punched along the bottom edge */
  -webkit-mask:linear-gradient(#000 0 0) 0 0/100% 28px no-repeat,
          radial-gradient(circle at 13px 100%,transparent 0 12px,#000 12.6px) 0 100%/26px 15px repeat-x;
          mask:linear-gradient(#000 0 0) 0 0/100% 28px no-repeat,
          radial-gradient(circle at 13px 100%,transparent 0 12px,#000 12.6px) 0 100%/26px 15px repeat-x;
  box-shadow:inset 0 -2px 0 rgba(0,0,0,.12)}
/* the pole and pennant at the peak */
.card.bz-carnival::after{
  content:"";position:absolute;left:50%;top:-2px;width:2px;height:16px;background:var(--gold);
  box-shadow:6px 3px 0 -1px var(--candy),8px 3px 0 -1px var(--candy),10px 4px 0 -2px var(--candy);
  z-index:2;pointer-events:none}
.card.bz-carnival > .bz-hdr{position:relative;margin-top:2px}
/* --- every card title is a bulb-outlined marquee sign. The dotted gold border IS
   the bulb row — at 3px it reads as lamps, and it costs no extra element. --- */
.card.bz-carnival > .bz-hdr h2.bz{
  display:inline-block;padding:7px 14px;border-radius:8px;letter-spacing:2px;text-transform:uppercase;
  font-size:14px;color:var(--bulb);background:linear-gradient(180deg,var(--grape),var(--grape-lo));
