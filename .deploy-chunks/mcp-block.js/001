    points_for: row.points_for,
    points_against: row.points_against,
    point_differential: row.point_differential,
    result: row.result,
  }));
  return toolText({
    query: {
      scope: input.scope,
      team: team.team,
      opponent: opponent ? opponent.team : null,
      week: input.week,
      season_type: input.seasonType,
      result: input.result,
      site: input.site,
      sort: input.sort,
      limit: input.limit,
