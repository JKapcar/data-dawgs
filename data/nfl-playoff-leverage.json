{
 "as_of": "2026-10-30",
 "source": "Data Dawgs season simulation (playoff-leverage-engine v1, work/playoff-leverage-engine.js) over /data/nfl-schedule.json results (snapshot sha256:208f9f4cc0ff…, captured 2026-10-30T03:26:13Z) and /data/survivor.json game probabilities (nfelo f72b2849, captured 2026-10-30).",
 "tier": "labs",
 "graded": false,
 "note": "SIMULATION OUTPUT, ungraded — not a forecast receipt and not a betting signal. Each of 100,000 simulated seasons keeps every finished game's real result and plays every unplayed 2026 regular-season game once at its /data/survivor.json home-win probability (the published nfelo forecast for the current week, the nfelo season projection after it). Leverage is paired: every season is also played with one game's result flipped while every other game keeps its simulated result. Team strength is held fixed and games are independent, so probabilities near 0% and 100% are overconfident. Seeding follows the NFL tie-breaking procedures through strength of schedule; a tie that survives SOS goes to a coin toss because points are not simulated. Daily snapshot: rebuilt after the nfelo refresh, deterministic for identical inputs.",
 "built": "2026-10-30",
 "canonical_url": "https://datadawgs216.com/data/nfl-playoff-leverage.json",
 "tier_meaning": "Pup — live and useful, not yet validated. It may compute real answers and still have open questions about calibration, assumptions, data quality or edge. Everything starts here.",
 "method": {
  "engine": "playoff-leverage-engine v1",
  "simulation": "100,000 seasons. Finals are real results (a tie counts half a win). Each unplayed game is one independent Bernoulli draw at p_home; no simulated ties.",
  "leverage": "Paired common random numbers: for each game of the target week, every simulated season is replayed with that result flipped. if_win and if_loss are P(playoffs) across all seasons with the team forced to win or lose that game; swing = if_win - if_loss. now = P(playoffs) across the unforced seasons.",
  "ordering": "Games by the sum of both teams' swings, largest first; within a game, the larger swing first.",
  "tiebreakers": "NFL division and wild-card procedures: head-to-head (wild-card multi-club: sweep only), division record, common games (wild card: minimum four), conference record, strength of victory, strength of schedule, then a per-season coin toss. Two clubs left by a multi-club step revert to two-club step 1; each division order is fixed before wild cards are drawn. Seeds 1-4 are division winners, 5-7 wild cards.",
  "precision": "Monte Carlo, paired: swing_se is each swing's standard error (probability scale). Largest on this file: 0.0014 for a swing, 0.0014 for any club's shift between a game's two results. The page lists other clubs' shifts of 0.002 (0.2 points) or more.",
  "limits": [
   "Team strength is fixed within a season and games are independent: no rating updates, injuries or QB changes beyond what p_home already carries. This understates uncertainty, so values near 0 and 1 are overconfident.",
   "Tie-breaking steps after strength of schedule (points-based) are not modelled; those ties go to a coin toss.",
   "A game whose final has not reached /data/nfl-schedule.json is simulated as unplayed, even after kickoff.",
   "Ungraded. Nothing here has been scored against outcomes, and it is not a consensus of models."
  ],
  "validation": "work/validate-playoff-history.mjs replays real seasons (nflverse/nfldata games.csv) through the same seeding code and requires every conference's actual playoff field, byes and wild-card pairings with hosts; it runs on every pull request that touches the engine."
 },
